---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="header-nav">
	<nav>
		<a href="/" class="brand-logo">
			<span class="logo-mark">PM</span>
			<span class="logo-text">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Accueil</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/a-propos/">À propos</HeaderLink>
		</div>
	</nav>
</header>

<style>
	.header-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(226, 232, 240, 0.8);
		padding: 0.6em 1.5em;
	}
	nav {
		max-width: 900px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand-logo {
		display: flex;
		align-items: center;
		gap: 0.6em;
		text-decoration: none;
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--text-main);
	}
	.logo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		background: var(--accent);
		color: #ffffff;
		font-size: 0.85rem;
		font-weight: 800;
		letter-spacing: -0.05em;
	}
	.logo-text {
		letter-spacing: -0.02em;
	}
	.internal-links {
		display: flex;
		gap: 0.5em;
	}
	.internal-links :global(a) {
		padding: 0.5em 0.85em;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--text-muted);
		border-radius: 8px;
		transition: all 0.15s ease;
		text-decoration: none;
	}
	.internal-links :global(a:hover) {
		color: var(--text-main);
		background: var(--bg-alt);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		font-weight: 600;
		background: var(--accent-subtle);
	}
</style>