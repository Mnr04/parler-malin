---
interface Props {
	date?: Date | string;
}

const { date } = Astro.props;
const validDate = date ? new Date(date) : null;
---

{
	validDate && !isNaN(validDate.getTime()) && (
		<time datetime={validDate.toISOString()}>
			{validDate.toLocaleDateString('fr-FR', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
	)
}