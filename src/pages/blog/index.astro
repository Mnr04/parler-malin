---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const PAGES_STATIQUES = [
    'a-propos',
    'conditions-generales-dutilisation',
    'mentions-legales',
    'plan-du-site',
    'politique-de-confidentialite-rgpd',
    'politique-de-cookies-ue',
    'home'
];

const posts = (await getCollection('blog'))
    .filter((post) => !PAGES_STATIQUES.includes(post.id))
    .sort((a, b) => {
        const dateA = new Date(a.data.pubDate || a.data.date || 0).valueOf();
        const dateB = new Date(b.data.pubDate || b.data.date || 0).valueOf();
        return dateB - dateA;
    });

const featuredPost = posts[0];
const regularPosts = posts.slice(1);
---

<!doctype html>
<html lang="fr">
    <head>
        <BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <style>
            .blog-main {
                max-width: 1200px;
                width: 100%;
                margin: 0 auto;
                padding: 2.5rem 1.5rem 5rem;
                box-sizing: border-box;
            }

            /* En-tête du Blog */
            .blog-header {
                margin-bottom: 2.75rem;
            }
            .blog-badge {
                display: inline-block;
                font-family: ui-monospace, SFMono-Regular, monospace;
                font-size: 0.74rem;
                font-weight: 700;
                color: #1a56db;
                letter-spacing: 0.05em;
                margin-bottom: 0.5rem;
            }
            .blog-title {
                font-size: clamp(2rem, 4vw, 2.75rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                color: #0f172a;
                margin: 0 0 0.75rem 0;
                line-height: 1.2;
            }
            .blog-subtitle {
                font-size: 1.05rem;
                color: #64748b;
                max-width: 620px;
                margin: 0;
                line-height: 1.6;
            }

            /* Article à la une (Featured Card) */
            .featured-section {
                margin-bottom: 3.5rem;
            }
            .featured-card {
                display: grid;
                grid-template-columns: 1.15fr 1fr;
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 16px;
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                box-shadow: 0 4px 20px rgba(15, 23, 42, 0.04);
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            }
            .featured-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
                border-color: #cbd5e1;
            }
            .featured-image-wrapper {
                position: relative;
                overflow: hidden;
                background: #f8fafc;
                aspect-ratio: 16 / 10;
            }
            .featured-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.35s ease;
                display: block;
            }
            .featured-card:hover .featured-img {
                transform: scale(1.03);
            }
            .featured-content {
                padding: 2.25rem 2.5rem;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }
            .featured-meta {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 0.85rem;
            }
            .badge-featured {
                background: #ebf5ff;
                color: #1a56db;
                font-family: ui-monospace, monospace;
                font-size: 0.7rem;
                font-weight: 700;
                padding: 0.2rem 0.55rem;
                border-radius: 4px;
                letter-spacing: 0.04em;
            }
            .post-date {
                font-size: 0.8rem;
                color: #64748b;
                font-family: ui-monospace, monospace;
            }
            .featured-title {
                font-size: clamp(1.4rem, 2.2vw, 1.85rem);
                font-weight: 800;
                color: #0f172a;
                line-height: 1.25;
                margin: 0 0 0.85rem 0;
                letter-spacing: -0.02em;
                transition: color 0.15s ease;
            }
            .featured-card:hover .featured-title {
                color: #1a56db;
            }
            .featured-desc {
                color: #475569;
                font-size: 0.95rem;
                line-height: 1.6;
                margin: 0 0 1.5rem 0;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .read-more-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                font-weight: 600;
                font-size: 0.9rem;
                color: #1a56db;
            }
            .arrow {
                transition: transform 0.2s ease;
            }
            .featured-card:hover .arrow,
            .post-card:hover .arrow {
                transform: translateX(4px);
            }

            /* Grille des autres articles */
            .posts-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
                gap: 2rem;
            }
            .post-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 14px;
                overflow: hidden;
                box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
                display: flex;
                flex-direction: column;
            }
            .post-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
                border-color: #cbd5e1;
            }
            .post-card-inner {
                display: flex;
                flex-direction: column;
                height: 100%;
                text-decoration: none;
                color: inherit;
            }
            .post-image-wrapper {
                aspect-ratio: 16 / 9;
                overflow: hidden;
                background: #f8fafc;
                position: relative;
            }
            .post-img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.35s ease;
                display: block;
            }
            .post-card:hover .post-img {
                transform: scale(1.04);
            }
            .post-content {
                padding: 1.35rem 1.4rem 1.25rem;
                display: flex;
                flex-direction: column;
                flex-grow: 1;
            }
            .post-meta {
                margin-bottom: 0.55rem;
            }
            .post-title {
                font-size: 1.15rem;
                font-weight: 700;
                color: #0f172a;
                line-height: 1.35;
                margin: 0 0 0.55rem 0;
                letter-spacing: -0.01em;
                transition: color 0.15s ease;
            }
            .post-card:hover .post-title {
                color: #1a56db;
            }
            .post-desc {
                font-size: 0.88rem;
                color: #475569;
                line-height: 1.55;
                margin: 0 0 1.25rem 0;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .post-footer {
                margin-top: auto;
                padding-top: 0.85rem;
                border-top: 1px solid #f1f5f9;
                display: flex;
                align-items: center;
                justify-content: flex-start;
            }
            .read-link {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                font-size: 0.85rem;
                font-weight: 600;
                color: #1a56db;
            }

            .empty-state {
                text-align: center;
                padding: 4rem 1rem;
                color: #64748b;
            }

            /* Responsive */
            @media (max-width: 860px) {
                .featured-card {
                    grid-template-columns: 1fr;
                }
                .featured-content {
                    padding: 1.5rem 1.5rem 1.75rem;
                }
                .featured-image-wrapper {
                    aspect-ratio: 16 / 9;
                }
            }

            @media (max-width: 640px) {
                .blog-main {
                    padding: 1.75rem 1rem 3.5rem;
                }
                .posts-grid {
                    grid-template-columns: 1fr;
                    gap: 1.25rem;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main class="blog-main">
            <header class="blog-header">
                <span class="blog-badge">LE BLOG // PARLER MALIN</span>
                <h1 class="blog-title">Tous les articles & guides</h1>
                <p class="blog-subtitle">
                    Méthodes pas à pas, retours d'expérience et réglages IA pour progresser en anglais sans perdre de temps.
                </p>
            </header>

            {posts.length === 0 ? (
                <div class="empty-state">
                    <p>Aucun article publié pour le moment.</p>
                </div>
            ) : (
                <>
                    {/* (le plus récent) */}
                    {featuredPost && (
                        <section class="featured-section" aria-label="Article à la une">
                            <a href={`/${featuredPost.id}/`} class="featured-card">
                                <div class="featured-image-wrapper">
                                    {featuredPost.data.heroImage && (
                                        <Image
                                            width={960}
                                            height={540}
                                            src={featuredPost.data.heroImage}
                                            alt={String(featuredPost.data.heroImageAlt || featuredPost.data.title || '')}
                                            loading="eager"
                                            class="featured-img"
                                        />
                                    )}
                                </div>
                                <div class="featured-content">
                                    <div class="featured-meta">
                                        <span class="badge-featured">DERNIER GUIDE</span>
                                        {(featuredPost.data.pubDate || featuredPost.data.date) && (
                                            <span class="post-date">
                                                <FormattedDate date={featuredPost.data.pubDate || featuredPost.data.date} />
                                            </span>
                                        )}
                                    </div>
                                    <h2 class="featured-title">{featuredPost.data.title}</h2>
                                    {featuredPost.data.description && (
                                        <p class="featured-desc">{featuredPost.data.description}</p>
                                    )}
                                    <div class="featured-footer">
                                        <span class="read-more-btn">
                                            Lire le guide complet <span class="arrow">&rarr;</span>
                                        </span>
                                    </div>
                                </div>
                            </a>
                        </section>
                    )}

                    {/* Grille des autres articles */}
                    {regularPosts.length > 0 && (
                        <section class="posts-section" aria-label="Autres articles">
                            <div class="posts-grid">
                                {regularPosts.map((post) => (
                                    <article class="post-card">
                                        <a href={`/${post.id}/`} class="post-card-inner">
                                            <div class="post-image-wrapper">
                                                {post.data.heroImage && (
                                                    <Image
                                                        width={640}
                                                        height={360}
                                                        src={post.data.heroImage}
                                                        alt={String(post.data.heroImageAlt || post.data.title || '')}
                                                        loading="lazy"
                                                        class="post-img"
                                                    />
                                                )}
                                            </div>
                                            <div class="post-content">
                                                <div class="post-meta">
                                                    {(post.data.pubDate || post.data.date) && (
                                                        <span class="post-date">
                                                            <FormattedDate date={post.data.pubDate || post.data.date} />
                                                        </span>
                                                    )}
                                                </div>
                                                <h3 class="post-title">{post.data.title}</h3>
                                                {post.data.description && (
                                                    <p class="post-desc">{post.data.description}</p>
                                                )}
                                                <div class="post-footer">
                                                    <span class="read-link">
                                                        Lire l'article <span class="arrow">&rarr;</span>
                                                    </span>
                                                </div>
                                            </div>
                                        </a>
                                    </article>
                                ))}
                            </div>
                        </section>
                    )}
                </>
            )}
        </main>
        <Footer />
    </body>
</html>