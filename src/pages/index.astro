---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE_TITLE } from '../consts';

const PAGES_EXCLUES = [
    'home',
    'a-propos',
    'conditions-generales-dutilisation',
    'mentions-legales',
    'plan-du-site',
    'politique-de-confidentialite-rgpd',
    'politique-de-cookies-ue',
];

const posts = (await getCollection('blog'))
    .filter((post) => !PAGES_EXCLUES.includes(post.id))
    .sort((a, b) => {
        const dateA = new Date(a.data.pubDate || a.data.date || 0).valueOf();
        const dateB = new Date(b.data.pubDate || b.data.date || 0).valueOf();
        return dateB - dateA;
    })
    .slice(0, 3);

// LE PROBLÈME 
const problemes = [
    {
        icone: '01',
        titre: 'La peur du jugement et du ridicule',
        desc: "Vous comprenez l'anglais à l'écrit ou en série, mais dès qu'il faut parler devant quelqu'un, vous bloquez par peur de faire des fautes ou à cause de votre accent.",
    },
    {
        icone: '02',
        titre: 'Personne avec qui pratiquer au quotidien',
        desc: "Autour de vous, personne ne parle anglais. Et payer un professeur particulier 3 fois par semaine à horaires fixes coûte cher et demande une grosse logistique.",
    },
    {
        icone: '03',
        titre: 'Les applis classiques ne font pas parler',
        desc: "Cocher des cases et traduire des phrases sur téléphone donne l'illusion de progresser, mais ne crée aucun réflexe quand vous devez formuler vos propres phrases à voix haute.",
    },
];

// 2. LA SOLUTION 
const beneficesSolution = [
    {
        titre: 'Zéro pression sociale',
        desc: "Une IA ne s'impatiente jamais, ne vous juge pas et vous laisse chercher vos mots autant de fois que nécessaire.",
    },
    {
        titre: 'Pratique vocale 24h/24',
        desc: "10 minutes dans votre salon ou avant de dormir : vous parlez à voix haute dès que vous avez un créneau libre.",
    },
    {
        titre: 'Corrections instantanées',
        desc: "Prononciation, grammaire ou tournures plus naturelles : le tuteur vous corrige en direct sans casser le fil de l'échange.",
    },
];

// LES TUTEURS IA 
const tuteursComparatif = [
    {
        rang: 'Parcours structuré',
        nom: 'Praktika AI',
        categorie: 'Avatars interactifs & Programme sur-mesure',
        note: '4,7/5 App Store',
        prix: 'Essai dispo • Abonnement accessible',
        usage: 'Idéal si vous voulez être guidé pas à pas avec des avatars réalistes (accents US, UK, Australien) et des mises en situation concrètes.',
        pointsForts: [
            'Programme personnalisé selon votre niveau',
            'Correction phonétique visuelle instantanée',
            'Excellent rapport fonctionnalités / prix',
        ],
        link: '/avis-praktika/',
        cta: 'Lire mon test de Praktika',
        featured: true,
    },
    {
        rang: 'Discussion libre',
        nom: 'Loora AI',
        categorie: 'Coach vocal conversationnel pur',
        note: '4,9/5 App Store',
        prix: 'Positionnement premium (iOS / Android)',
        usage: 'Conçu pour ceux qui veulent discuter librement comme au téléphone avec une voix ultra-naturelle et un retour grammatical immédiat.',
        pointsForts: [
            'Fluidité vocale bluffante de réalisme',
            'Corrections en temps réel très pertinentes',
            'Interface mobile épurée et rapide',
        ],
        link: '/loora-app-avis/',
        cta: 'Lire mon test de Loora',
        featured: false,
    },
    {
        rang: 'Option gratuite',
        nom: 'ChatGPT & Gemini',
        categorie: 'IA généralistes (Mode Vocal)',
        note: null,
        prix: 'Gratuit (ou ~22€/mois en version Plus)',
        usage: 'Pratique pour tester l’oral à 0€ avec ses propres consignes, mais demande de tout paramétrer soi-même sans programme ni suivi d’accent.',
        pointsForts: [
            '100% gratuit pour dépanner',
            'Simulations de jeux de rôle libres',
            'Aucun suivi pédagogique intégré',
        ],
        link: '/meilleures-ia-anglais/',
        cta: 'Comparer avec les tuteurs dédiés',
        featured: false,
    },
];

// FAQ sobre, factuelle et neutre
const faq = [
    {
        q: "Quel tuteur IA choisir pour pratiquer l'anglais en 2026 ?",
        a: "Les applications que je recommande actuellement, comme Loora AI (4,9/5) et Praktika AI (4,7/5), sont très bien notées par les utilisateurs sur l'App Store. Loora convient davantage aux discussions libres, tandis que Praktika propose un parcours plus guidé avec des avatars. Le secteur évoluant vite, je continue de tester régulièrement les nouveautés pour mettre à jour mes comparatifs.",
    },
    {
        q: "Un tuteur IA peut-il remplacer un vrai professeur ou une certification ?",
        a: "Non. Une application IA ne remplace ni l'accompagnement d'un professeur diplômé, ni une certification officielle (TOEIC, IELTS, Cambridge). C'est simplement un outil complémentaire pour pratiquer l'oral plus souvent entre vos cours ou en autonomie.",
    },
    {
        q: "Peut-on utiliser ChatGPT ou Gemini gratuitement comme tuteur vocal ?",
        a: "Oui, c'est tout à fait possible grâce à leur mode vocal gratuit. La principale différence est que cela demande une configuration préalable : vous devez donner des consignes précises (prompts) pour cadrer la discussion, et il n'y a pas de programme structuré ni de suivi d'erreurs d'une session à l'autre contrairement à une application dédiée.",
    },
    {
        q: "Qu'apporte une pratique régulière de 10 à 15 minutes par jour ?",
        a: "Un tuteur IA ne permet pas de devenir bilingue sans effort. En revanche, pratiquer un peu chaque jour aide à prendre l'habitude de formuler ses phrases à voix haute, à mobiliser son vocabulaire plus facilement et à être plus à l'aise lors d'une conversation.",
    },
    {
        q: "Comment sont financés les tests présents sur ce site ?",
        a: "L'accès aux articles et comparatifs est entièrement gratuit. Le site est financé par l'affiliation : si vous choisissez de tester une application en passant par certains liens présents sur le site, je peux recevoir une commission, sans aucun coût supplémentaire pour vous.",
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, a }) => ({
                '@type': 'Question',
                name: q,
                acceptedAnswer: { '@type': 'Answer', text: a },
            })),
        },
        {
            '@type': 'ItemList',
            name: 'Comparatif des meilleurs Tuteurs IA Anglais 2026',
            itemListElement: tuteursComparatif.map((t, idx) => ({
                '@type': 'ListItem',
                position: idx + 1,
                name: t.nom,
                description: t.usage,
                url: `https://parlermalin.fr${t.link}`,
            })),
        },
    ],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
    <head>
        <BaseHead
            title={`Meilleur Tuteur IA Anglais (2026) : Comparatif & Tests Réels | ${SITE_TITLE}`}
            description="Peur de parler anglais à l'oral ? Découvrez mes tests indépendants des meilleurs tuteurs vocaux IA (Praktika, Loora, ChatGPT...) pour pratiquer sans jugement."
        />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <style>
            :root {
                --bg: #fafafa;
                --surface: #ffffff;
                --surface-subtle: #f4f4f5;
                --surface-dark: #09090b;
                --border: #e4e4e7;
                --border-strong: #d4d4d8;
                --text-main: #09090b;
                --text-muted: #52525b;
                --text-faint: #71717a;
                --accent: #2563eb;
                --accent-hover: #1d4ed8;
                --amber-bg: #fef3c7;
                --amber-text: #92400e;
                --radius-lg: 18px;
                --radius-md: 12px;
                --radius-sm: 6px;
            }

            *, *::before, *::after {
                box-sizing: border-box;
            }

            html, body {
                overflow-x: hidden;
                width: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                background-color: var(--bg);
                color: var(--text-main);
                font-family: 'General Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                -webkit-font-smoothing: antialiased;
                line-height: 1.6;
            }

            main {
                max-width: 1140px;
                width: 100%;
                margin: 0 auto;
                padding: 3rem 1.75rem 7rem;
            }

            a:focus-visible, summary:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 3px;
            }

            h2 {
                font-size: clamp(1.6rem, 3.2vw, 2.35rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                line-height: 1.18;
                color: var(--text-main);
                margin: 0 0 0.6rem;
                overflow-wrap: break-word;
            }

            .section-header-split {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 1.5rem;
                margin-bottom: 2.75rem;
                padding-bottom: 1.5rem;
                border-bottom: 1px solid var(--border);
                flex-wrap: wrap;
            }
            .section-header-split p {
                margin: 0;
                color: var(--text-muted);
                max-width: 540px;
                font-size: 1rem;
                line-height: 1.65;
            }

            /* 1. HERO : ESPACE & RESPIRATION PREMIUM */
            .hero {
                display: grid;
                grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
                gap: 3.75rem;
                align-items: center;
                padding: 2.5rem 0 5.5rem;
                border-bottom: 1px solid var(--border);
                margin-bottom: 6.5rem;
            }
            .hero > div,
            .hero > aside {
                min-width: 0;
            }
            .hero h1 {
                font-size: clamp(2.1rem, 4.2vw, 3.45rem);
                font-weight: 800;
                line-height: 1.1;
                letter-spacing: -0.035em;
                margin: 0 0 1.5rem;
                color: var(--text-main);
                overflow-wrap: break-word;
            }
            .hero h1 span {
                color: var(--accent);
            }
            .hero-lead {
                font-size: 1.1rem;
                color: var(--text-muted);
                line-height: 1.7;
                margin: 0 0 2.25rem;
                max-width: 540px;
            }
            .hero-actions {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
                align-items: center;
            }
            .btn-primary {
                background: var(--accent);
                color: #fff;
                padding: 1.05rem 1.65rem;
                border-radius: var(--radius-md);
                font-size: 0.98rem;
                font-weight: 700;
                text-decoration: none;
                border: 1px solid var(--accent);
                box-shadow: 0 8px 20px -4px rgba(37, 99, 235, 0.35);
                transition: transform 0.15s ease, background-color 0.15s ease;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                max-width: 100%;
            }
            .btn-primary:hover {
                background: var(--accent-hover);
                transform: translateY(-2px);
            }
            .btn-secondary {
                background: var(--surface);
                color: var(--text-main);
                border: 1px solid var(--border-strong);
                padding: 1.05rem 1.65rem;
                border-radius: var(--radius-md);
                font-size: 0.98rem;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: border-color 0.15s ease, background-color 0.15s ease;
                max-width: 100%;
            }
            .btn-secondary:hover {
                background: var(--surface-subtle);
                border-color: var(--text-main);
            }
            .hero-meta {
                margin-top: 1.75rem;
                font-size: 0.85rem;
                color: var(--text-muted);
                display: flex;
                gap: 0.75rem 1.5rem;
                flex-wrap: wrap;
                font-weight: 500;
            }

            /* Widget Aperçu dans le Hero */
            .verdict-widget {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 1.75rem;
                box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.05);
                width: 100%;
            }
            .verdict-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 0.5rem;
                padding-bottom: 1rem;
                margin-bottom: 1.15rem;
                border-bottom: 1px solid var(--border);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.74rem;
                font-weight: 700;
                letter-spacing: 0.04em;
                color: var(--text-muted);
            }
            .verdict-list {
                display: flex;
                flex-direction: column;
                gap: 0.9rem;
            }
            .verdict-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
                padding: 1rem 1.15rem;
                border-radius: var(--radius-md);
                border: 1px solid var(--border);
                background: var(--bg);
                text-decoration: none;
                color: inherit;
                transition: border-color 0.15s ease, transform 0.15s ease, background-color 0.15s ease;
                min-width: 0;
            }
            .verdict-row > div {
                min-width: 0;
            }
            .verdict-row:hover {
                border-color: var(--accent);
                background: var(--surface);
                transform: translateX(2px);
            }
            .verdict-name {
                font-weight: 800;
                font-size: 1rem;
                color: var(--text-main);
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
            }
            .badge-score {
                background: var(--amber-bg);
                color: var(--amber-text);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.7rem;
                padding: 0.18rem 0.45rem;
                border-radius: 5px;
                font-weight: 700;
            }
            .verdict-sub {
                font-size: 0.82rem;
                color: var(--text-muted);
                margin-top: 0.25rem;
            }
            .verdict-action {
                font-size: 0.84rem;
                font-weight: 700;
                color: var(--accent);
                white-space: nowrap;
                flex-shrink: 0;
            }

            /* 2. LE PROBLÈME / EMPATHIE */
            .problem-section {
                margin-bottom: 6.5rem;
            }
            .problem-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1.75rem;
            }
            .problem-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 2rem;
                min-width: 0;
                box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.03);
            }
            .problem-num {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.78rem;
                font-weight: 800;
                color: var(--text-faint);
                background: var(--surface-subtle);
                padding: 0.3rem 0.65rem;
                border-radius: var(--radius-sm);
                display: inline-block;
                margin-bottom: 1.15rem;
            }
            .problem-card h3 {
                font-size: 1.15rem;
                font-weight: 800;
                margin: 0 0 0.65rem;
                color: var(--text-main);
            }
            .problem-card p {
                font-size: 0.94rem;
                color: var(--text-muted);
                line-height: 1.65;
                margin: 0;
            }

            /* 3. LA SOLUTION / BÉNÉFICES */
            .solution-section {
                background: var(--surface-dark);
                color: #fff;
                border-radius: var(--radius-lg);
                padding: 3.75rem 3rem;
                margin-bottom: 6.5rem;
            }
            .solution-header {
                max-width: 680px;
                margin-bottom: 2.75rem;
            }
            .solution-header h2 {
                color: #fff;
                margin-bottom: 0.85rem;
            }
            .solution-header p {
                color: #a1a1aa;
                font-size: 1.02rem;
                line-height: 1.7;
                margin: 0;
            }
            .solution-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1.5rem;
            }
            .solution-item {
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: var(--radius-md);
                padding: 1.75rem;
                min-width: 0;
            }
            .solution-item h3 {
                font-size: 1.08rem;
                font-weight: 800;
                color: #fff;
                margin: 0 0 0.6rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            .solution-item h3::before {
                content: "✓";
                color: #60a5fa;
                font-weight: 800;
            }
            .solution-item p {
                font-size: 0.92rem;
                color: #d4d4d8;
                line-height: 1.65;
                margin: 0;
            }

            /* 4. COMPARATIF & PREUVE SOCIALE (GRILLE 3 COLONNES) */
            .tutors-section {
                margin-bottom: 6.5rem;
                scroll-margin-top: 2.5rem;
            }
            .social-proof-bar {
                background: var(--surface-subtle);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                padding: 1.1rem 1.5rem;
                margin-bottom: 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 0.75rem;
                font-size: 0.9rem;
                color: var(--text-muted);
            }
            .social-proof-bar strong {
                color: var(--text-main);
            }
            .tutors-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1.75rem;
                margin-bottom: 2rem;
                align-items: stretch;
            }
            .tutor-card {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 2rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
                min-width: 0;
            }
            .tutor-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 18px 35px -12px rgba(0, 0, 0, 0.08);
            }
            .tutor-card.is-featured {
                border: 2px solid var(--accent);
                background: linear-gradient(180deg, #eff6ff 0%, #ffffff 30%);
            }
            .tutor-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.1rem;
                gap: 0.5rem;
                flex-wrap: wrap;
            }
            .tutor-rank {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.7rem;
                font-weight: 800;
                text-transform: uppercase;
                padding: 0.28rem 0.6rem;
                border-radius: var(--radius-sm);
                background: var(--surface-subtle);
                color: var(--text-main);
            }
            .tutor-card.is-featured .tutor-rank {
                background: var(--accent);
                color: #fff;
            }
            .tutor-score {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.74rem;
                font-weight: 700;
                color: var(--amber-text);
                background: var(--amber-bg);
                padding: 0.25rem 0.55rem;
                border-radius: var(--radius-sm);
            }
            .tutor-title {
                font-size: 1.35rem;
                font-weight: 800;
                margin: 0 0 0.3rem;
                color: var(--text-main);
            }
            .tutor-cat {
                font-size: 0.86rem;
                font-weight: 600;
                color: var(--accent);
                margin: 0 0 1rem;
            }
            .tutor-desc {
                font-size: 0.93rem;
                color: var(--text-muted);
                line-height: 1.65;
                margin: 0 0 1.35rem;
            }
            .tutor-bullets {
                list-style: none;
                padding: 0;
                margin: 0 0 1.75rem;
                display: flex;
                flex-direction: column;
                gap: 0.6rem;
                border-top: 1px dashed var(--border);
                padding-top: 1.15rem;
            }
            .tutor-bullets li {
                font-size: 0.86rem;
                color: var(--text-main);
                display: flex;
                align-items: flex-start;
                gap: 0.5rem;
                font-weight: 500;
                line-height: 1.45;
            }
            .tutor-bullets li::before {
                content: "✓";
                color: var(--accent);
                font-weight: 800;
                flex-shrink: 0;
            }
            .tutor-footer {
                margin-top: auto;
                display: flex;
                flex-direction: column;
                gap: 0.7rem;
            }
            .tutor-price {
                font-size: 0.78rem;
                color: var(--text-faint);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            }
            .tutor-btn {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                width: 100%;
                padding: 0.95rem 1.15rem;
                border-radius: var(--radius-md);
                font-size: 0.92rem;
                font-weight: 700;
                text-decoration: none;
                background: var(--surface-dark);
                color: #fff;
                transition: background-color 0.15s ease;
                text-align: center;
            }
            .tutor-card.is-featured .tutor-btn {
                background: var(--accent);
            }
            .tutor-btn:hover {
                background: var(--accent-hover);
            }
            .compare-banner {
                background: var(--surface-subtle);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-md);
                padding: 1.35rem 1.65rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
                font-size: 0.95rem;
            }
            .link-strong {
                font-weight: 800;
                color: var(--text-main);
                text-decoration: none;
                border-bottom: 2px solid var(--accent);
                padding-bottom: 2px;
            }
            .link-strong:hover {
                color: var(--accent);
            }

            /* 5. BARRE AUTEUR MINIMALISTE (JÉRÉMY) */
            .author-strip {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 1.5rem 2rem;
                margin-bottom: 6.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1.5rem;
                flex-wrap: wrap;
                box-shadow: 0 10px 30px -15px rgba(0, 0, 0, 0.03);
            }
            .author-signature {
                display: flex;
                align-items: center;
                gap: 1rem;
                min-width: 0;
            }
            .author-monogram {
                width: 44px;
                height: 44px;
                border-radius: var(--radius-md);
                background: var(--surface-dark);
                color: #fff;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-weight: 800;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
            .author-name {
                font-weight: 800;
                font-size: 1rem;
                margin: 0;
                color: var(--text-main);
            }
            .author-role {
                font-size: 0.86rem;
                color: var(--text-muted);
                margin: 0.15rem 0 0;
            }

            /* 6. BLOG */
            .blog-section {
                margin-bottom: 6.5rem;
            }
            .blog-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 1.75rem;
            }
            .post-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                display: flex;
                flex-direction: column;
                transition: border-color 0.15s ease, transform 0.15s ease;
                min-width: 0;
            }
            .post-card:hover {
                border-color: var(--text-main);
                transform: translateY(-3px);
            }
            .post-image {
                height: 190px;
                width: 100%;
                object-fit: cover;
                background: var(--surface-subtle);
                border-bottom: 1px solid var(--border);
            }
            .post-content {
                padding: 1.5rem;
                flex-grow: 1;
                display: flex;
                flex-direction: column;
            }
            .post-title {
                font-size: 1.05rem;
                font-weight: 800;
                line-height: 1.4;
                margin: 0 0 1rem;
                color: var(--text-main);
            }
            .post-card:hover .post-title {
                color: var(--accent);
            }
            .post-date {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.76rem;
                color: var(--text-faint);
                margin-top: auto;
            }

            /* 7. FAQ */
            .faq-section {
                margin-bottom: 6.5rem;
            }
            .faq-list {
                display: flex;
                flex-direction: column;
                border-top: 1px solid var(--border-strong);
            }
            .faq-item {
                border-bottom: 1px solid var(--border-strong);
            }
            .faq-item summary {
                padding: 1.4rem 0.25rem;
                font-size: 1.04rem;
                font-weight: 700;
                color: var(--text-main);
                cursor: pointer;
                list-style: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
            }
            .faq-item summary::-webkit-details-marker {
                display: none;
            }
            .faq-item summary:hover {
                color: var(--accent);
            }
            .faq-item summary::after {
                content: "+";
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 1.35rem;
                color: var(--text-muted);
                flex-shrink: 0;
            }
            .faq-item[open] summary::after {
                content: "−";
                color: var(--accent);
            }
            .faq-answer {
                padding: 0 0.25rem 1.5rem;
                font-size: 0.95rem;
                color: var(--text-muted);
                line-height: 1.7;
                max-width: 780px;
            }

            /* 8. CTA FINAL */
            .final-cta {
                background: var(--surface-dark);
                color: #fff;
                border-radius: var(--radius-lg);
                padding: 3.5rem 3rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 2.25rem;
                flex-wrap: wrap;
            }
            .final-cta-text {
                max-width: 580px;
                min-width: 0;
            }
            .final-cta-text h2 {
                color: #fff;
                margin: 0 0 0.65rem;
            }
            .final-cta-text p {
                color: #a1a1aa;
                margin: 0;
                font-size: 1rem;
                line-height: 1.65;
            }
            .final-cta-buttons {
                display: flex;
                gap: 0.85rem;
                flex-wrap: wrap;
            }
            .btn-light {
                background: var(--accent);
                color: #fff;
                padding: 1.05rem 1.65rem;
                border-radius: var(--radius-md);
                font-size: 0.96rem;
                font-weight: 800;
                text-decoration: none;
                transition: transform 0.15s ease, background-color 0.15s ease;
                text-align: center;
                display: inline-flex;
                justify-content: center;
                align-items: center;
            }
            .btn-light:hover {
                background: var(--accent-hover);
                transform: translateY(-2px);
            }

            /* RESPONSIVE TABLETTE & MOBILE AÉRÉ */
            @media (max-width: 980px) {
                .problem-grid,
                .solution-grid,
                .tutors-grid,
                .blog-grid {
                    grid-template-columns: repeat(2, minmax(0, 1fr));
                }
            }

            @media (max-width: 768px) {
                main {
                    padding: 2rem 1.35rem 5rem;
                }
                .hero,
                .problem-grid,
                .solution-grid,
                .tutors-grid,
                .blog-grid {
                    grid-template-columns: minmax(0, 1fr);
                    gap: 1.5rem;
                }
                .hero {
                    padding: 1.25rem 0 3.75rem;
                    margin-bottom: 4.25rem;
                    gap: 2.5rem;
                }
                .hero h1 {
                    font-size: 2rem;
                    line-height: 1.15;
                    margin-bottom: 1.25rem;
                }
                .hero-lead {
                    font-size: 1rem;
                    line-height: 1.65;
                    margin-bottom: 1.85rem;
                }
                .hero-actions,
                .final-cta-buttons {
                    width: 100%;
                    flex-direction: column;
                    gap: 0.85rem;
                }
                .btn-primary,
                .btn-secondary,
                .btn-light {
                    width: 100%;
                    text-align: center;
                    padding: 1rem 1.25rem;
                }
                .hero-meta {
                    margin-top: 1.5rem;
                    gap: 0.6rem 1.25rem;
                }
                .verdict-widget {
                    padding: 1.35rem;
                }
                .verdict-row {
                    padding: 0.95rem 1rem;
                }
                .section-header-split {
                    margin-bottom: 2rem;
                    padding-bottom: 1.15rem;
                }
                .problem-card,
                .tutor-card {
                    padding: 1.65rem;
                }
                .problem-section,
                .solution-section,
                .tutors-section,
                .author-strip,
                .blog-section,
                .faq-section {
                    margin-bottom: 4.5rem;
                }
                .solution-section,
                .final-cta {
                    padding: 2.25rem 1.5rem;
                }
                .author-strip {
                    padding: 1.35rem 1.4rem;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
                html {
                    scroll-behavior: auto;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <!-- HERO  -->
            <section class="hero">
                <div>
                    <h1>
                        Débloquez votre oral en anglais grâce aux <span>Tuteurs Vocaux IA</span>.
                    </h1>
                    <p class="hero-lead">
                        Fini la peur du jugement ou le manque d'interlocuteur. Je teste en conditions réelles les applications de conversation IA pour vous aider à choisir celle qui vous fera vraiment parler au quotidien.
                    </p>
                    <div class="hero-actions">
                        <a href="#comparatif" class="btn-primary">
                            <span>Découvrir les Tuteurs IA testés</span>
                            <span aria-hidden="true">&darr;</span>
                        </a>
                        <a href="/meilleures-ia-anglais/" class="btn-secondary">
                            Voir le comparatif complet
                        </a>
                    </div>
                    <div class="hero-meta">
                        <span>✓ Pratique orale 24h/24</span>
                        <span>✓ Zéro peur du regard des autres</span>
                    </div>
                </div>

                <!-- Aperçu Preuve Sociale & Tests -->
                <aside class="verdict-widget" aria-label="Aperçu des tuteurs IA les mieux notés">
                    <div class="verdict-header">
                        <span>APPLICATIONS LES MIEUX NOTÉES</span>
                        <span>App Store</span>
                    </div>
                    <div class="verdict-list">
                        <a href="/avis-praktika/" class="verdict-row">
                            <div>
                                <div class="verdict-name">
                                    Praktika AI
                                    <span class="badge-score">★ 4,7/5</span>
                                                                    </div>
                                <div class="verdict-sub">Avatars immersifs & parcours guidé</div>
                            </div>
                            <span class="verdict-action">Voir le test &rarr;</span>
                        </a>

                        <a href="/loora-app-avis/" class="verdict-row">
                            <div>
                                <div class="verdict-name">
                                    Loora AI
                                    <span class="badge-score">★ 4,9/5</span>
                                </div>
                                <div class="verdict-sub">Conversation libre ultra-fluide</div>
                            </div>
                            <span class="verdict-action">Voir le test &rarr;</span>
                        </a>

                        <a href="/meilleures-ia-anglais/" class="verdict-row">
                            <div>
                                <div class="verdict-name">ChatGPT, Gemini & autres</div>
                                <div class="verdict-sub">Que valent les options gratuites à l'oral ?</div>
                            </div>
                            <span class="verdict-action">Comparer &rarr;</span>
                        </a>
                    </div>
                </aside>
            </section>

            <!-- 2. LE PROBLÈME / L'EMPATHIE -->
            <section class="problem-section">
                <div class="section-header-split">
                    <div>
                        <h2>Pourquoi parler anglais à voix haute reste si difficile ?</h2>
                    </div>
                    <p>Comprendre l'anglais dans sa tête et réussir à sortir une phrase fluide à l'oral sont deux exercices totalement différents.</p>
                </div>

                <div class="problem-grid">
                    {
                        problemes.map((prob) => (
                            <article class="problem-card">
                                <span class="problem-num">{prob.icone}</span>
                                <h3>{prob.titre}</h3>
                                <p>{prob.desc}</p>
                            </article>
                        ))
                    }
                </div>
            </section>

            <!-- 3. LA SOLUTION / LES BÉNÉFICES -->
            <section class="solution-section">
                <div class="solution-header">
                    <h2>Le Tuteur Vocal IA : le chaînon manquant pour oser parler</h2>
                    <p>
                        Un tuteur IA ne remplace pas un professeur diplômé, mais il règle le problème numéro 1 en France : le manque de pratique orale quotidienne. Mon rôle sur ce site est de tester ces applications pour vous orienter vers les plus efficaces.
                    </p>
                </div>

                <div class="solution-grid">
                    {
                        beneficesSolution.map((ben) => (
                            <div class="solution-item">
                                <h3>{ben.titre}</h3>
                                <p>{ben.desc}</p>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- 4. LE TABLEAU COMPARATIF + PREUVE SOCIALE -->
            <section id="comparatif" class="tutors-section">
                <div class="section-header-split">
                    <div>
                        <h2>Les meilleurs Tuteurs IA testés selon votre profil</h2>
                    </div>
                    <p>Basé sur mes tests en conditions réelles et sur les notes vérifiées de l'App Store.</p>
                </div>

                <div class="social-proof-bar">
                    <span><strong>Preuve sociale :</strong> Sélection d'applications notées entre <strong>4,7/5 et 4,9/5</strong> par les utilisateurs mobiles.</span>
                    <span>Mis à jour en 2026</span>
                </div>

                <div class="tutors-grid">
                    {
                        tuteursComparatif.map((tuteur) => (
                            <article class={`tutor-card ${tuteur.featured ? 'is-featured' : ''}`}>
                                <div>
                                    <div class="tutor-top">
                                        {tuteur.rang && <span class="tutor-rank">{tuteur.rang}</span>}
                                        {tuteur.note && <span class="tutor-score">★ {tuteur.note}</span>}
                                    </div>
                                    <h3 class="tutor-title">{tuteur.nom}</h3>
                                    <p class="tutor-cat">{tuteur.categorie}</p>
                                    <p class="tutor-desc">{tuteur.usage}</p>
                                    <ul class="tutor-bullets">
                                        {tuteur.pointsForts.map((pt) => (
                                            <li>{pt}</li>
                                        ))}
                                    </ul>
                                </div>
                                <div class="tutor-footer">
                                    <span class="tutor-price">Tarif : {tuteur.prix}</span>
                                    <a href={tuteur.link} class="tutor-btn">
                                        {tuteur.cta} &rarr;
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <div class="compare-banner">
                    <span>Vous voulez comparer l'ensemble des applications (prix, essais gratuits, alternatives) ?</span>
                    <a href="/meilleures-ia-anglais/" class="link-strong">
                        Accéder au comparatif complet des Tuteurs IA &rarr;
                    </a>
                </div>
            </section>

            <!-- AUTEUR -->
            <section class="author-strip">
                <div class="author-signature">
                    <div class="author-monogram" aria-hidden="true">JM</div>
                    <div>
                        <p class="author-name">Jérémy — Parler Malin</p>
                        <p class="author-role">Tests indépendants en conditions réelles</p>
                    </div>
                </div>
                <a href="/a-propos/" class="link-strong">
                    À propos & méthode de test &rarr;
                </a>
            </section>

            <!-- 6. BLOG -->
            <section class="blog-section">
                <div class="section-header-split">
                    <div>
                        <h2>Derniers tests et questions fréquentes</h2>
                    </div>
                    <a href="/blog/" class="link-strong">Voir tous les articles &rarr;</a>
                </div>

                <div class="blog-grid">
                    {
                        posts.map((post) => (
                            <a href={`/${post.id}/`} class="post-card">
                                {post.data.heroImage && (
                                    <img
                                        src={typeof post.data.heroImage === 'string' ? post.data.heroImage : (post.data.heroImage as any)?.src}
                                        alt={String((post.data as any).heroImageAlt || post.data.title || '')}
                                        width="640"
                                        height="360"
                                        loading="lazy"
                                        class="post-image"
                                    />
                                )}
                                <div class="post-content">
                                    <h3 class="post-title">{post.data.title}</h3>
                                    <span class="post-date">
                                        {(post.data.pubDate || post.data.date) && (
                                            <FormattedDate date={post.data.pubDate || post.data.date} />
                                        )}
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>

            <!-- 7. FAQ -->
            <section class="faq-section">
                <div class="section-header-split">
                    <div>
                        <h2>Questions fréquentes sur les Tuteurs IA</h2>
                    </div>
                </div>

                <div class="faq-list">
                    {
                        faq.map(({ q, a }) => (
                            <details class="faq-item">
                                <summary>{q}</summary>
                                <div class="faq-answer">{a}</div>
                            </details>
                        ))
                    }
                </div>
            </section>

            <!-- 8. CTA FINAL -->
            <section class="final-cta">
                <div class="final-cta-text">
                    <h2>Trouvez le tuteur vocal adapté à votre niveau et votre budget</h2>
                    <p>
                        Consultez mon tableau comparatif complet (fonctionnalités, tarifs, essais gratuits et nouvelles applications testées) pour choisir l'outil qui vous correspond.
                    </p>
                </div>
                <div class="final-cta-buttons">
                    <a href="/meilleures-ia-anglais/" class="btn-light">
                        Voir le comparatif complet des Tuteurs IA &rarr;
                    </a>
                </div>
            </section>
        </main>
        <Footer />
        <CookieBanner />
    </body>
</html>