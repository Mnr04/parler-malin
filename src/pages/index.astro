---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE_TITLE } from '../consts';

const PAGES_EXCLUES = [
    'home',
    'a-propos',
    'conditions-generales-dutilisation',
    'mentions-legales',
    'plan-du-site',
    'politique-de-confidentialite-rgpd',
    'politique-de-cookies-ue',
];

const posts = (await getCollection('blog'))
    .filter((post) => !PAGES_EXCLUES.includes(post.id))
    .sort((a, b) => {
        const dateA = new Date(a.data.pubDate || a.data.date || 0).valueOf();
        const dateB = new Date(b.data.pubDate || b.data.date || 0).valueOf();
        return dateB - dateA;
    })
    .slice(0, 3);

// Les 3 Tuteurs IA (Grille 3 colonnes)
const tuteursComparatif = [
    {
        rang: 'Meilleur rapport qualité/prix',
        nom: 'Praktika AI',
        categorie: 'Avatars interactifs & Parcours guidé',
        note: '4,7/5 App Store',
        prix: 'Essai dispo • Abonnement accessible',
        usage: 'Idéal si vous voulez un programme structuré clé en main avec des avatars réalistes (accents US, UK, Australien) qui corrigent votre prononciation en direct.',
        pointsForts: [
            'Parcours personnalisé selon votre niveau',
            'Correction phonétique visuelle instantanée',
            'Excellent rapport fonctionnalités / prix',
        ],
        link: '/avis-praktika/',
        cta: 'Voir mon test & offre Praktika',
        featured: true,
    },
    {
        rang: 'Note #1 App Store',
        nom: 'Loora AI',
        categorie: 'Coach vocal conversationnel pur',
        note: '4,9/5 App Store',
        prix: 'Positionnement premium (iOS / Android)',
        usage: 'Conçu pour ceux qui veulent discuter à l’oral de sujets libres au quotidien avec une voix très naturelle et un retour grammatical immédiat.',
        pointsForts: [
            'Fluidité vocale ultra-naturelle',
            'Corrections en temps réel pertinentes',
            'Interface mobile simple et rapide',
        ],
        link: '/loora-app-avis/',
        cta: 'Lire mon test de Loora',
        featured: false,
    },
    {
        rang: 'Option gratuite',
        nom: 'ChatGPT & Gemini',
        categorie: 'IA généralistes (Mode Vocal)',
        note: null,
        prix: 'Gratuit (ou ~22€/mois en version Plus)',
        usage: 'Pratique pour tester l’oral à 0€ avec ses propres consignes, mais demande de tout paramétrer soi-même sans programme ni suivi d’accent.',
        pointsForts: [
            '100% gratuit pour dépanner',
            'Simulations de jeux de rôle libres',
            'Aucun suivi pédagogique intégré',
        ],
        link: '/meilleures-ia-anglais/',
        cta: 'Comparer avec les tuteurs dédiés',
        featured: false,
    },
];

// FAQ réaliste, transparente et basée sur les notes utilisateurs
const faq = [
    {
        q: "Quel est le meilleur tuteur IA pour apprendre l'anglais en 2026 ?",
        a: "Si l'on se base sur les notes des utilisateurs sur l'App Store, Loora AI arrive en tête (4,9/5) pour la fluidité de ses conversations libres, suivie de très près par Praktika AI (4,7/5). En pratique, les deux applications sont excellentes : choisissez Loora si vous cherchez un échange vocal pur, ou Praktika si vous préférez un parcours structuré avec des avatars interactifs et un tarif plus accessible.",
    },
    {
        q: "Un tuteur IA peut-il remplacer un vrai professeur d'anglais ou une formation certifiante ?",
        a: "Non. Une application IA ne remplace ni l'accompagnement pédagogique d'un professeur diplômé, ni une certification officielle (TOEIC, IELTS, Cambridge). C'est en revanche un excellent outil d'entraînement quotidien pour pratiquer l'oral entre deux cours, gagner en aisance et lever la peur de parler.",
    },
    {
        q: "Quelle est la différence entre ChatGPT / Gemini et une application dédiée comme Praktika ou Loora ?",
        a: "ChatGPT et Gemini sont des outils généralistes : leur mode vocal dépanne très bien gratuitement, mais ils ne proposent ni programme d'apprentissage, ni suivi de vos erreurs récurrentes. Praktika et Loora sont conçus spécifiquement pour l'anglais avec des leçons calibrées et des retours précis sur votre prononciation et votre grammaire.",
    },
    {
        q: "À quels résultats réalistes peut-on s'attendre avec ces applications ?",
        a: "Un tuteur IA ne vous rendra pas bilingue par magie sans effort. En pratiquant 10 à 15 minutes régulièrement, il vous aide surtout à débloquer vos automatismes à l'oral, à enrichir votre vocabulaire actif et à ne plus chercher vos mots lors de vraies conversations.",
    },
    {
        q: "Comment sont financés les tests présents sur ce site ?",
        a: "Tous les comparatifs et avis sont accessibles gratuitement. Le site se finance de manière transparente via l'affiliation : si vous décidez d'essayer Praktika ou Loora en passant par mes liens, je peux percevoir une commission sans aucun surcoût pour vous (et parfois avec une réduction sur votre abonnement).",
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, a }) => ({
                '@type': 'Question',
                name: q,
                acceptedAnswer: { '@type': 'Answer', text: a },
            })),
        },
        {
            '@type': 'ItemList',
            name: 'Classement des meilleurs Tuteurs IA Anglais 2026',
            itemListElement: tuteursComparatif.map((t, idx) => ({
                '@type': 'ListItem',
                position: idx + 1,
                name: t.nom,
                description: t.usage,
                url: `https://parlermalin.fr${t.link}`,
            })),
        },
    ],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
    <head>
        <BaseHead
            title={`Meilleur Tuteur IA Anglais (2026) : Comparatif Praktika, Loora & ChatGPT | ${SITE_TITLE}`}
            description="Quel tuteur IA choisir pour pratiquer l'anglais à l'oral ? Comparatif et tests de Praktika (4,7/5), Loora (4,9/5), ChatGPT et Gemini : prix, différences et avis."
        />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <style>
            :root {
                --bg: #fafafa;
                --surface: #ffffff;
                --surface-subtle: #f4f4f5;
                --surface-dark: #09090b;
                --border: #e4e4e7;
                --border-strong: #d4d4d8;
                --text-main: #09090b;
                --text-muted: #52525b;
                --text-faint: #71717a;
                --accent: #2563eb;
                --accent-hover: #1d4ed8;
                --accent-subtle: #eff6ff;
                --amber-bg: #fef3c7;
                --amber-text: #92400e;
                --radius-lg: 14px;
                --radius-md: 10px;
                --radius-sm: 6px;
            }

            * {
                box-sizing: border-box;
            }

            body {
                background-color: var(--bg);
                color: var(--text-main);
                font-family: 'General Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                margin: 0;
                -webkit-font-smoothing: antialiased;
                line-height: 1.5;
            }

            main {
                max-width: 1120px;
                margin: 0 auto;
                padding: 1.5rem 1.25rem 5rem;
            }

            a:focus-visible, summary:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 3px;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 0.45rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.06em;
                color: var(--accent);
                background: var(--accent-subtle);
                padding: 0.3rem 0.65rem;
                border-radius: var(--radius-sm);
                margin-bottom: 0.85rem;
            }

            h2 {
                font-size: clamp(1.6rem, 3vw, 2.15rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                line-height: 1.15;
                color: var(--text-main);
                margin: 0 0 0.4rem;
            }

            .section-header-split {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 1.25rem;
                margin-bottom: 2rem;
                padding-bottom: 1rem;
                border-bottom: 1px solid var(--border);
                flex-wrap: wrap;
            }
            .section-header-split p {
                margin: 0;
                color: var(--text-muted);
                max-width: 540px;
                font-size: 0.98rem;
            }

            /* 1. HERO */
            .hero {
                display: grid;
                grid-template-columns: 1.15fr 0.85fr;
                gap: 2.5rem;
                align-items: center;
                padding: 2rem 0 4rem;
                border-bottom: 1px solid var(--border);
                margin-bottom: 4rem;
            }
            .hero h1 {
                font-size: clamp(2.1rem, 4vw, 3.25rem);
                font-weight: 800;
                line-height: 1.08;
                letter-spacing: -0.035em;
                margin: 0 0 1.15rem;
                color: var(--text-main);
            }
            .hero h1 span {
                color: var(--accent);
            }
            .hero-lead {
                font-size: 1.08rem;
                color: var(--text-muted);
                line-height: 1.6;
                margin: 0 0 1.75rem;
                max-width: 540px;
            }
            .hero-actions {
                display: flex;
                gap: 0.85rem;
                flex-wrap: wrap;
                align-items: center;
            }
            .btn-primary {
                background: var(--accent);
                color: #fff;
                padding: 0.95rem 1.5rem;
                border-radius: var(--radius-md);
                font-size: 0.95rem;
                font-weight: 700;
                text-decoration: none;
                border: 1px solid var(--accent);
                box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
                transition: transform 0.15s ease, background-color 0.15s ease;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
            }
            .btn-primary:hover {
                background: var(--accent-hover);
                transform: translateY(-2px);
            }
            .btn-secondary {
                background: var(--surface);
                color: var(--text-main);
                border: 1px solid var(--border-strong);
                padding: 0.95rem 1.35rem;
                border-radius: var(--radius-md);
                font-size: 0.95rem;
                font-weight: 700;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                transition: border-color 0.15s ease, background-color 0.15s ease;
            }
            .btn-secondary:hover {
                background: var(--surface-subtle);
                border-color: var(--text-main);
            }
            .hero-meta {
                margin-top: 1.25rem;
                font-size: 0.82rem;
                color: var(--text-muted);
                display: flex;
                gap: 1.15rem;
                flex-wrap: wrap;
                font-weight: 500;
            }

            /* Widget Verdict Rapide */
            .verdict-widget {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.06);
            }
            .verdict-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-bottom: 0.85rem;
                margin-bottom: 1rem;
                border-bottom: 1px solid var(--border);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--text-muted);
            }
            .verdict-list {
                display: flex;
                flex-direction: column;
                gap: 0.75rem;
            }
            .verdict-row {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 0.85rem 1rem;
                border-radius: var(--radius-md);
                border: 1px solid var(--border);
                background: var(--bg);
                text-decoration: none;
                color: inherit;
                transition: border-color 0.15s ease, transform 0.15s ease;
            }
            .verdict-row:hover {
                border-color: var(--accent);
                transform: translateX(2px);
            }
            .verdict-row.is-top {
                background: var(--surface);
                border: 2px solid var(--accent);
            }
            .verdict-name {
                font-weight: 800;
                font-size: 0.98rem;
                color: var(--text-main);
                display: flex;
                align-items: center;
                gap: 0.5rem;
                flex-wrap: wrap;
            }
            .badge-top {
                background: var(--accent);
                color: #fff;
                font-size: 0.68rem;
                padding: 0.15rem 0.45rem;
                border-radius: 4px;
                font-weight: 700;
            }
            .verdict-sub {
                font-size: 0.8rem;
                color: var(--text-muted);
                margin-top: 0.15rem;
            }
            .verdict-action {
                font-size: 0.82rem;
                font-weight: 700;
                color: var(--accent);
                white-space: nowrap;
            }

            /* 2. GRILLE 3 COLONNES DES TUTEURS IA */
            .tutors-section {
                margin-bottom: 5rem;
            }
            .tutors-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 1.25rem;
                margin-bottom: 1.5rem;
                align-items: stretch;
            }
            .tutor-card {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                transition: transform 0.15s ease, box-shadow 0.15s ease;
            }
            .tutor-card:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 24px -10px rgba(0, 0, 0, 0.08);
            }
            .tutor-card.is-featured {
                border: 2px solid var(--accent);
                background: linear-gradient(180deg, #eff6ff 0%, #ffffff 28%);
            }
            .tutor-top {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 0.85rem;
                gap: 0.5rem;
                min-height: 26px;
            }
            .tutor-rank {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.7rem;
                font-weight: 800;
                text-transform: uppercase;
                padding: 0.22rem 0.55rem;
                border-radius: var(--radius-sm);
                background: var(--surface-subtle);
                color: var(--text-main);
            }
            .tutor-card.is-featured .tutor-rank {
                background: var(--accent);
                color: #fff;
            }
            .tutor-score {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                font-weight: 700;
                color: var(--amber-text);
                background: var(--amber-bg);
                padding: 0.2rem 0.5rem;
                border-radius: var(--radius-sm);
            }
            .tutor-title {
                font-size: 1.25rem;
                font-weight: 800;
                margin: 0 0 0.2rem;
                color: var(--text-main);
            }
            .tutor-cat {
                font-size: 0.82rem;
                font-weight: 600;
                color: var(--accent);
                margin: 0 0 0.75rem;
            }
            .tutor-desc {
                font-size: 0.9rem;
                color: var(--text-muted);
                line-height: 1.55;
                margin: 0 0 1.1rem;
            }
            .tutor-bullets {
                list-style: none;
                padding: 0;
                margin: 0 0 1.35rem;
                display: flex;
                flex-direction: column;
                gap: 0.45rem;
                border-top: 1px dashed var(--border);
                padding-top: 0.9rem;
            }
            .tutor-bullets li {
                font-size: 0.83rem;
                color: var(--text-main);
                display: flex;
                align-items: flex-start;
                gap: 0.45rem;
                font-weight: 500;
                line-height: 1.4;
            }
            .tutor-bullets li::before {
                content: "✓";
                color: var(--accent);
                font-weight: 800;
                flex-shrink: 0;
            }
            .tutor-footer {
                margin-top: auto;
                display: flex;
                flex-direction: column;
                gap: 0.55rem;
            }
            .tutor-price {
                font-size: 0.75rem;
                color: var(--text-faint);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            }
            .tutor-btn {
                display: inline-flex;
                justify-content: center;
                align-items: center;
                width: 100%;
                padding: 0.8rem 1rem;
                border-radius: var(--radius-md);
                font-size: 0.88rem;
                font-weight: 700;
                text-decoration: none;
                background: var(--surface-dark);
                color: #fff;
                transition: background-color 0.15s ease;
                text-align: center;
            }
            .tutor-card.is-featured .tutor-btn {
                background: var(--accent);
            }
            .tutor-btn:hover {
                background: var(--accent-hover);
            }
            .compare-banner {
                background: var(--surface-subtle);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-md);
                padding: 1.15rem 1.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
                font-size: 0.95rem;
            }
            .link-strong {
                font-weight: 800;
                color: var(--text-main);
                text-decoration: none;
                border-bottom: 2px solid var(--accent);
                padding-bottom: 2px;
            }
            .link-strong:hover {
                color: var(--accent);
            }

            /* 3. BLOC POURQUOI CE SITE (SIMPLIFIÉ) */
            .editorial-box {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 2rem 2.25rem;
                margin-bottom: 5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 2rem;
                flex-wrap: wrap;
            }
            .editorial-content {
                max-width: 680px;
            }
            .editorial-content p {
                color: var(--text-muted);
                font-size: 0.96rem;
                line-height: 1.6;
                margin: 0.5rem 0 0;
            }
            .editorial-meta {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.85rem;
                flex-shrink: 0;
            }
            .author-signature {
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }
            .author-monogram {
                width: 40px;
                height: 40px;
                border-radius: var(--radius-md);
                background: var(--surface-dark);
                color: #fff;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-weight: 800;
                font-size: 0.9rem;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
            .author-name {
                font-weight: 800;
                font-size: 0.95rem;
                margin: 0;
                color: var(--text-main);
            }
            .author-role {
                font-size: 0.8rem;
                color: var(--text-faint);
                margin: 0;
            }

            /* 4. BLOG */
            .blog-section {
                margin-bottom: 5rem;
            }
            .blog-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
                gap: 1.25rem;
            }
            .post-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                display: flex;
                flex-direction: column;
                transition: border-color 0.15s ease, transform 0.15s ease;
            }
            .post-card:hover {
                border-color: var(--text-main);
                transform: translateY(-2px);
            }
            .post-image {
                height: 175px;
                width: 100%;
                object-fit: cover;
                background: var(--surface-subtle);
                border-bottom: 1px solid var(--border);
            }
            .post-content {
                padding: 1.25rem;
                flex-grow: 1;
                display: flex;
                flex-direction: column;
            }
            .post-title {
                font-size: 1.02rem;
                font-weight: 800;
                line-height: 1.35;
                margin: 0 0 0.75rem;
                color: var(--text-main);
            }
            .post-card:hover .post-title {
                color: var(--accent);
            }
            .post-date {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                color: var(--text-faint);
                margin-top: auto;
            }

            /* 5. FAQ */
            .faq-section {
                margin-bottom: 5rem;
            }
            .faq-list {
                display: flex;
                flex-direction: column;
                border-top: 1px solid var(--border-strong);
            }
            .faq-item {
                border-bottom: 1px solid var(--border-strong);
            }
            .faq-item summary {
                padding: 1.25rem 0.25rem;
                font-size: 1.02rem;
                font-weight: 700;
                color: var(--text-main);
                cursor: pointer;
                list-style: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
            }
            .faq-item summary::-webkit-details-marker {
                display: none;
            }
            .faq-item summary:hover {
                color: var(--accent);
            }
            .faq-item summary::after {
                content: "+";
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 1.3rem;
                color: var(--text-muted);
            }
            .faq-item[open] summary::after {
                content: "−";
                color: var(--accent);
            }
            .faq-answer {
                padding: 0 0.25rem 1.35rem;
                font-size: 0.94rem;
                color: var(--text-muted);
                line-height: 1.6;
                max-width: 780px;
            }

            /* 6. CTA FINAL */
            .final-cta {
                background: var(--surface-dark);
                color: #fff;
                border-radius: var(--radius-lg);
                padding: 3rem 2.25rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 2rem;
                flex-wrap: wrap;
            }
            .final-cta-text {
                max-width: 540px;
            }
            .final-cta-text h2 {
                color: #fff;
                margin: 0 0 0.5rem;
            }
            .final-cta-text p {
                color: #a1a1aa;
                margin: 0;
                font-size: 0.98rem;
                line-height: 1.55;
            }
            .final-cta-buttons {
                display: flex;
                gap: 0.75rem;
                flex-wrap: wrap;
            }
            .btn-light {
                background: var(--accent);
                color: #fff;
                padding: 0.95rem 1.4rem;
                border-radius: var(--radius-md);
                font-size: 0.92rem;
                font-weight: 800;
                text-decoration: none;
                transition: transform 0.15s ease, background-color 0.15s ease;
                white-space: nowrap;
            }
            .btn-light:hover {
                background: var(--accent-hover);
                transform: translateY(-2px);
            }
            .btn-outline-light {
                background: transparent;
                color: #fff;
                border: 1px solid #3f3f46;
                padding: 0.95rem 1.35rem;
                border-radius: var(--radius-md);
                font-size: 0.92rem;
                font-weight: 700;
                text-decoration: none;
                white-space: nowrap;
                transition: border-color 0.15s ease;
            }
            .btn-outline-light:hover {
                border-color: #fff;
            }

            /* RESPONSIVE TABLETTE & MOBILE FIRST */
            @media (max-width: 980px) {
                .tutors-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @media (max-width: 860px) {
                .hero,
                .tutors-grid {
                    grid-template-columns: 1fr;
                    gap: 1.75rem;
                }
                .hero {
                    padding: 1rem 0 2.75rem;
                    margin-bottom: 3rem;
                }
                .hero-actions,
                .final-cta-buttons {
                    width: 100%;
                }
                .btn-primary,
                .btn-secondary,
                .btn-light,
                .btn-outline-light {
                    width: 100%;
                    text-align: center;
                }
                .editorial-box,
                .final-cta {
                    padding: 1.5rem 1.15rem;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                * {
                    transition: none !important;
                }
                html {
                    scroll-behavior: auto;
                }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <!-- 1. HERO -->
            <section class="hero">
                <div>
                    <h1>
                        Trouvez le meilleur <span>Tuteur IA</span> pour parler anglais sans bloquer.
                    </h1>
                    <p class="hero-lead">
                        Un tuteur vocal disponible 24h/24 dans votre poche pour pratiquer l'oral sans la peur du jugement.
                    </p>
                    <div class="hero-actions">
                        <a href="/avis-praktika/" class="btn-primary">
                            <span>Découvrir Praktika AI</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                        <a href="/meilleures-ia-anglais/" class="btn-secondary">
                            Comparatif complet des Tuteurs
                        </a>
                    </div>
                    <div class="hero-meta">
                        <span>✓ Tests indépendants</span>
                        <span>✓ Focus fluidité orale</span>
                        <span>✓ Réponses directes sans blabla</span>
                    </div>
                </div>

                <!-- Verdict Rapide -->
                <aside class="verdict-widget" aria-label="Classement rapide des tuteurs IA">
                    <div class="verdict-header">
                        <span>SYNTHÈSE DES TESTS</span>
                        <span>Notes App Store</span>
                    </div>
                    <div class="verdict-list">
                        <a href="/avis-praktika/" class="verdict-row is-top">
                            <div>
                                <div class="verdict-name">
                                    Praktika AI
                                    <span class="badge-top">★ 4,7/5</span>
                                </div>
                                <div class="verdict-sub">Avatars immersifs & parcours structuré</div>
                            </div>
                            <span class="verdict-action">Mon test &rarr;</span>
                        </a>

                        <a href="/loora-app-avis/" class="verdict-row">
                            <div>
                                <div class="verdict-name">
                                    Loora AI
                                    <span class="badge-top" style="background: var(--surface-dark);">★ 4,9/5</span>
                                </div>
                                <div class="verdict-sub">Meilleure fluidité en discussion libre</div>
                            </div>
                            <span class="verdict-action">Mon test &rarr;</span>
                        </a>

                        <a href="/meilleures-ia-anglais/" class="verdict-row">
                            <div>
                                <div class="verdict-name">ChatGPT / Gemini</div>
                                <div class="verdict-sub">Option gratuite (sans suivi d'accent)</div>
                            </div>
                            <span class="verdict-action">Comparer &rarr;</span>
                        </a>
                    </div>
                </aside>
            </section>

            <!-- 2. COMPARATIF TOP 3 -->
            <section id="tuteurs" class="tutors-section">
                <div class="section-header-split">
                    <div>
                        <h2>Quel tuteur IA choisir selon votre profil ?</h2>
                    </div>
                    <p>Pas besoin d'essayer 10 applications. Voici les 3 solutions les plus pertinentes aujourd'hui.</p>
                </div>

                <div class="tutors-grid">
                    {
                        tuteursComparatif.map((tuteur) => (
                            <article class={`tutor-card ${tuteur.featured ? 'is-featured' : ''}`}>
                                <div>
                                    <div class="tutor-top">
                                        {tuteur.rang && <span class="tutor-rank">{tuteur.rang}</span>}
                                        {tuteur.note && <span class="tutor-score">★ {tuteur.note}</span>}
                                    </div>
                                    <h3 class="tutor-title">{tuteur.nom}</h3>
                                    <p class="tutor-cat">{tuteur.categorie}</p>
                                    <p class="tutor-desc">{tuteur.usage}</p>
                                    <ul class="tutor-bullets">
                                        {tuteur.pointsForts.map((pt) => (
                                            <li>{pt}</li>
                                        ))}
                                    </ul>
                                </div>
                                <div class="tutor-footer">
                                    <span class="tutor-price">Tarif : {tuteur.prix}</span>
                                    <a href={tuteur.link} class="tutor-btn">
                                        {tuteur.cta} &rarr;
                                    </a>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <div class="compare-banner">
                    <span>Vous voulez voir le tableau comparatif détaillé (prix, voix, essais gratuits) ?</span>
                    <a href="/meilleures-ia-anglais/" class="link-strong">
                        Lire le guide des meilleurs Tuteurs IA Anglais &rarr;
                    </a>
                </div>
            </section>

            <!-- 3. POURQUOI CE SITE (SIMPLIFIÉ -> RENVOIE VERS A PROPOS) -->
            <section class="editorial-box">
                <div class="editorial-content">
                    <span class="eyebrow">Pourquoi ce site ?</span>
                    <h2>Des tests concrets pour choisir sans perdre de temps</h2>
                    <p>
                        Sur Parler Malin, je teste chaque tuteur IA en conditions réelles pour vous donner une réponse directe : quelle application correspond à votre niveau, combien ça coûte vraiment et dans quels cas ChatGPT gratuit suffit.
                    </p>
                </div>

                <div class="editorial-meta">
                    <div class="author-signature">
                        <div class="author-monogram" aria-hidden="true">RM</div>
                        <div>
                            <p class="author-name">Remy — Parler Malin</p>
                            <p class="author-role">Testeur indépendant</p>
                        </div>
                    </div>
                    <a href="/a-propos/" class="link-strong">
                        En savoir plus sur ma démarche &rarr;
                    </a>
                </div>
            </section>

            <!-- 4. BLOG -->
            <section class="blog-section">
                <div class="section-header-split">
                    <div>
                        <h2>Derniers tests et comparatifs</h2>
                    </div>
                    <a href="/blog/" class="link-strong">Voir tous les articles &rarr;</a>
                </div>

                <div class="blog-grid">
                    {
                        posts.map((post) => (
                            <a href={`/${post.id}/`} class="post-card">
                                {post.data.heroImage && (
                                    <img
                                        src={typeof post.data.heroImage === 'string' ? post.data.heroImage : (post.data.heroImage as any)?.src}
                                        alt={String((post.data as any).heroImageAlt || post.data.title || '')}
                                        width="640"
                                        height="360"
                                        loading="lazy"
                                        class="post-image"
                                    />
                                )}
                                <div class="post-content">
                                    <h3 class="post-title">{post.data.title}</h3>
                                    <span class="post-date">
                                        {(post.data.pubDate || post.data.date) && (
                                            <FormattedDate date={post.data.pubDate || post.data.date} />
                                        )}
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>

            <!-- 5. FAQ -->
            <section class="faq-section">
                <div class="section-header-split">
                    <div>
                        <h2>Questions fréquentes sur les Tuteurs IA</h2>
                    </div>
                </div>

                <div class="faq-list">
                    {
                        faq.map(({ q, a }) => (
                            <details class="faq-item">
                                <summary>{q}</summary>
                                <div class="faq-answer">{a}</div>
                            </details>
                        ))
                    }
                </div>
            </section>

            <!-- 6. CTA FINAL ÉQUILIBRÉ -->
            <section class="final-cta">
                <div class="final-cta-text">
                    <h2>Praktika ou Loora : lequel est fait pour vous ?</h2>
                    <p>
                        Les deux applications sont d'excellents tuteurs vocaux, mais leur approche diffère. Consultez mes tests complets ou le comparatif détaillé pour faire votre choix.
                    </p>
                </div>
                <div class="final-cta-buttons">
                    <a href="/avis-praktika/" class="btn-light">
                        Mon test de Praktika &rarr;
                    </a>
                    <a href="/loora-app-avis/" class="btn-outline-light">
                        Mon test de Loora &rarr;
                    </a>
                    <a href="/meilleures-ia-anglais/" class="btn-outline-light">
                        Comparatif complet
                    </a>
                </div>
            </section>
        </main>
        <Footer />
        <CookieBanner />
    </body>
</html>