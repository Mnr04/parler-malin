---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE_TITLE } from '../consts';

const PAGES_EXCLUES = [
    'home',
    'a-propos',
    'conditions-generales-dutilisation',
    'mentions-legales',
    'plan-du-site',
    'politique-de-confidentialite-rgpd',
    'politique-de-cookies-ue',
];

const posts = (await getCollection('blog'))
    .filter((post) => !PAGES_EXCLUES.includes(post.id))
    .sort((a, b) => {
        const dateA = new Date(a.data.pubDate || a.data.date || 0).valueOf();
        const dateB = new Date(b.data.pubDate || b.data.date || 0).valueOf();
        return dateB - dateA;
    })
    .slice(0, 3);

const etapes = [
    {
        num: '01',
        phase: 'Diagnostic',
        duree: '10 min',
        title: 'Estimer son vrai niveau',
        desc: "Les prompts à copier-coller pour transformer ChatGPT en examinateur interactif (QCM, compréhension et oral) sans passer par un test scolaire biaisé.",
        link: '/test-niveau-anglais-chatgpt/',
        cta: "Faire le test de niveau",
        featured: true,
    },
    {
        num: '02',
        phase: 'Structure',
        duree: '5 min',
        title: 'Bâtir son plan d’étude',
        desc: "Le prompt exact pour découper votre apprentissage et générer une routine réaliste adaptée à votre emploi du temps.",
        link: '/routine-anglais-chatgpt/',
        cta: "Générer mon planning",
    },
    {
        num: '03',
        phase: 'Fondations',
        duree: '10 min/jour',
        title: 'Vocabulaire & Grammaire utiles',
        desc: "Apprenez uniquement les mots et structures liés à votre métier ou vos passions grâce à des mises en contexte sur mesure.",
        link: '/apprendre-vocabulaire-anglais-chatgpt/',
        cta: 'Cibler mon vocabulaire',
    },
    {
        num: '04',
        phase: 'Phonétique',
        duree: '5 min/jour',
        title: 'Corriger sa prononciation',
        desc: "Comment utiliser les coachs vocaux IA pour détecter vos tics de prononciation francophones et fluidifier votre accent.",
        link: '/ia-prononciation-anglais/',
        cta: "Travailler mon accent",
    },
    {
        num: '05',
        phase: 'Immersion',
        duree: '10 min/jour',
        title: 'Converser à voix haute',
        desc: "Simulations et jeux de rôle guidés (réunion pro, voyage, débat) pour parler à l'oral sans la peur du jugement.",
        link: '/reussir-conversation-en-anglais-avec-ia/',
        cta: 'Lancer un dialogue vocal',
    },
    {
        num: '06',
        phase: 'Terrain',
        duree: '1x / semaine',
        title: 'Valider avec des natifs',
        desc: "Le protocole pour passer de l'entraînement sécurisé avec l'IA aux vraies conversations humaines avec fluidité.",
        link: '/pratiquer-anglais-natifs/',
        cta: 'Passer aux échanges réels',
    },
];

const outilsComparatif = [
    {
        nom: 'Loora AI',
        categorie: 'Coach vocal dédié',
        usage: 'Idéal pour pratiquer l’oral quotidiennement sur mobile avec corrections en temps réel.',
        verdict: 'Le plus fluide à l’oral',
        link: '/loora-app-avis/',
        cta: 'Lire mon test de Loora',
    },
    {
        nom: 'Praktika',
        categorie: 'Avatars interactifs',
        usage: 'Mises en situation visuelles et parcours structurés avec différents accents (US, UK).',
        verdict: 'Le plus immersif',
        link: '/avis-praktika/',
        cta: 'Lire mon test de Praktika',
    },
    {
        nom: 'Preply',
        categorie: 'Professeurs natifs',
        usage: 'Indispensable pour valider ses acquis IA face à un vrai interlocuteur humain.',
        verdict: 'Le complément humain',
        link: '/avis-preply/',
        cta: 'Lire mon avis sur Preply',
    },
];

const faq = [
    {
        q: "Est-il vraiment possible d'apprendre l'anglais de zéro avec l'IA ?",
        a: `Oui, à condition de ne pas utiliser l'IA comme un simple dictionnaire. Utilisé avec des consignes précises (prompts), ChatGPT agit comme un tuteur disponible 24h/24 : il adapte les textes à votre niveau, génère des dialogues sur vos centres d'intérêt et corrige vos fautes instantanément. Vous passez d'un apprentissage passif à une pratique active dès le premier jour.`,
    },
    {
        q: "Comment pratiquer l'oral et l'accent tout seul devant son écran ?",
        a: `Avec le mode vocal de ChatGPT ou des applications spécialisées comme Loora, vous discutez à voix haute comme au téléphone. L'IA vous écoute, vous répond et pointe vos erreurs de prononciation ou de syntaxe. Le principal levier psychologique est là : vous pratiquez sans la peur du ridicule, ce qui débloque la prise de parole beaucoup plus vite.`,
    },
    {
        q: 'Faut-il payer ChatGPT Plus (version payante) pour appliquer cette méthode ?',
        a: `Non. Tous les prompts et protocoles partagés sur ce site fonctionnent avec la version gratuite de ChatGPT. La version payante ou les applications spécialisées apportent un confort supplémentaire (voix plus naturelles, corrections phonétiques poussées), mais ne sont pas obligatoires pour démarrer.`,
    },
    {
        q: "Pourquoi l'ensemble des guides et prompts du site sont-ils 100 % gratuits ?",
        a: `Je tiens à garder toutes mes ressources et méthodes en accès libre, sans mur payant ni inscription forcée. Le site se finance de manière transparente via l'affiliation : si vous décidez d'essayer une application payante (comme Loora, Praktika ou Preply) en passant par mes liens après avoir lu mes tests, je perçois une commission sans aucun surcoût pour vous.`,
    },
    {
        q: 'Combien de temps par jour faut-il y consacrer pour voir des résultats ?',
        a: `La régularité bat toujours l'intensité. 15 à 20 minutes par jour (par exemple, 10 minutes d'échange vocal le matin et 10 minutes de vocabulaire contextualisé le soir) donnent de bien meilleurs résultats qu'un bloc de 2 heures le dimanche.`,
    },
    {
        q: "Quelle est la meilleure IA pour apprendre l'anglais en 2026 ?",
        a: `Il n'existe pas d'outil unique parfait pour tout le monde. Pour l'écrit, la grammaire sur mesure et les jeux de rôle gratuits, ChatGPT reste imbattable. Pour un suivi pur de la prononciation et de la spontanéité orale sur téléphone, Loora et Praktika sont nettement mieux calibrés. Et pour casser la barrière finale du réel, rien ne remplace un tuteur humain sur Preply.`,
    },
];

const structuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'FAQPage',
            mainEntity: faq.map(({ q, a }) => ({
                '@type': 'Question',
                name: q,
                acceptedAnswer: { '@type': 'Answer', text: a },
            })),
        },
        {
            '@type': 'ItemList',
            name: "Plan en 6 étapes pour apprendre l'anglais avec l'IA",
            itemListElement: etapes.map((e, idx) => ({
                '@type': 'ListItem',
                position: idx + 1,
                name: e.title,
                description: e.desc,
                url: `https://parlermalin.fr${e.link}`,
            })),
        },
    ],
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
    <head>
        <BaseHead
            title={`Apprendre l'Anglais avec l'IA : Méthode & Prompts | ${SITE_TITLE}`}
            description="Carnet de méthodes concrètes, prompts ChatGPT et tests d'applications vocales pour progresser en anglais à l'oral et à l'écrit en 15 min par jour."
        />

        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

        <style>
            :root {
                --bg: #faf8f5;
                --surface: #ffffff;
                --surface-warm: #f3efe8;
                --surface-dark: #141413;
                --border: #e4dfd5;
                --border-strong: #c9c1b4;
                --text-main: #141413;
                --text-muted: #4a4843;
                --text-faint: #78746c;
                --accent: #1d4ed8;
                --accent-hover: #1e3a8a;
                --accent-subtle: #eff6ff;
                --highlight-warm: #fef3c7;
                --amber-text: #92400e;
                --radius-lg: 12px;
                --radius-md: 8px;
                --radius-sm: 4px;
            }

            * { box-sizing: border-box; }

            body {
                background-color: var(--bg);
                color: var(--text-main);
                font-family: 'General Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                margin: 0;
                -webkit-font-smoothing: antialiased;
                line-height: 1.5;
            }

            main {
                max-width: 1100px;
                margin: 0 auto;
                padding: 2rem 1.5rem 6rem;
            }

            a:focus-visible, summary:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: 3px;
            }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                color: var(--text-muted);
                margin-bottom: 0.75rem;
            }
            .eyebrow::before {
                content: "";
                display: inline-block;
                width: 8px;
                height: 8px;
                background: var(--accent);
                border-radius: 2px;
            }

            h2 {
                font-size: clamp(1.65rem, 3vw, 2.2rem);
                font-weight: 800;
                letter-spacing: -0.03em;
                line-height: 1.15;
                color: var(--text-main);
                margin: 0 0 0.5rem;
            }

            .section-header-split {
                display: flex;
                justify-content: space-between;
                align-items: flex-end;
                gap: 1.5rem;
                margin-bottom: 2.25rem;
                padding-bottom: 1.25rem;
                border-bottom: 1px solid var(--border);
                flex-wrap: wrap;
            }
            .section-header-split p {
                margin: 0;
                color: var(--text-muted);
                max-width: 540px;
                font-size: 1rem;
            }

            /* 1. HERO ASYMÉTRIQUE */
            .hero {
                display: grid;
                grid-template-columns: 1.15fr 0.85fr;
                gap: 3rem;
                align-items: center;
                padding: 3rem 0 4.5rem;
                border-bottom: 1px solid var(--border);
                margin-bottom: 4.5rem;
            }
            .hero-badge {
                display: inline-block;
                background: var(--surface-warm);
                border: 1px solid var(--border-strong);
                padding: 0.3rem 0.75rem;
                border-radius: var(--radius-sm);
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                font-weight: 600;
                color: var(--text-main);
                margin-bottom: 1.25rem;
            }
            .hero h1 {
                font-size: clamp(2.25rem, 4.2vw, 3.4rem);
                font-weight: 800;
                line-height: 1.08;
                letter-spacing: -0.035em;
                margin: 0 0 1.25rem;
                color: var(--text-main);
            }
            .hero h1 mark {
                background-color: var(--highlight-warm);
                color: var(--text-main);
                padding: 0 0.25rem;
                border-radius: 4px;
                box-decoration-break: clone;
                -webkit-box-decoration-break: clone;
            }
            .hero-lead {
                font-size: 1.125rem;
                color: var(--text-muted);
                line-height: 1.65;
                margin: 0 0 2rem;
                max-width: 560px;
            }
            .hero-actions {
                display: flex;
                gap: 0.85rem;
                flex-wrap: wrap;
                align-items: center;
            }
            .btn-primary {
                background: var(--text-main);
                color: #fff;
                padding: 0.9rem 1.5rem;
                border-radius: var(--radius-md);
                font-size: 0.95rem;
                font-weight: 700;
                text-decoration: none;
                border: 1px solid var(--text-main);
                box-shadow: 0 3px 0 var(--accent);
                transition: transform 0.15s ease, background-color 0.15s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }
            .btn-primary:hover {
                background: var(--accent);
                border-color: var(--accent);
                transform: translateY(-2px);
            }
            .btn-secondary {
                background: var(--surface);
                color: var(--text-main);
                border: 1px solid var(--border-strong);
                padding: 0.9rem 1.4rem;
                border-radius: var(--radius-md);
                font-size: 0.95rem;
                font-weight: 600;
                text-decoration: none;
                transition: border-color 0.15s ease, background-color 0.15s ease;
            }
            .btn-secondary:hover {
                background: var(--surface-warm);
                border-color: var(--text-main);
            }
            .hero-meta {
                margin-top: 1.25rem;
                font-size: 0.82rem;
                color: var(--text-faint);
                display: flex;
                gap: 1.25rem;
                flex-wrap: wrap;
            }

            /* Carte de démonstration (Preuve concrète dans le Hero) */
            .prompt-preview {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 1.5rem;
                box-shadow: 6px 6px 0 var(--border);
            }
            .prompt-preview-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 1px dashed var(--border);
                padding-bottom: 0.75rem;
                margin-bottom: 1rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                color: var(--text-faint);
            }
            .prompt-tag {
                background: var(--accent-subtle);
                color: var(--accent);
                padding: 0.15rem 0.5rem;
                border-radius: 4px;
                font-weight: 700;
            }
            .prompt-box {
                background: var(--surface-warm);
                border-left: 3px solid var(--text-main);
                padding: 0.85rem 1rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.82rem;
                color: var(--text-main);
                line-height: 1.55;
                margin-bottom: 1rem;
                border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
            }
            .prompt-feedback {
                font-size: 0.85rem;
                color: var(--text-muted);
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
                padding: 0.75rem 1rem;
                border-radius: var(--radius-md);
            }
            .prompt-feedback strong { color: #166534; }

            /* 2. ROADMAP (6 ÉTAPES) */
            .roadmap-section { margin-bottom: 5.5rem; }
            .steps-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
                gap: 1.25rem;
            }
            .step-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                padding: 1.65rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                position: relative;
                transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
            }
            .step-card:hover {
                border-color: var(--text-main);
                transform: translateY(-2px);
                box-shadow: 4px 4px 0 var(--border-strong);
            }
            .step-card.is-featured {
                border: 2px solid var(--text-main);
                background: linear-gradient(to bottom, #ffffff, #faf8f5);
            }
            .step-top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 1.1rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.78rem;
            }
            .step-num {
                font-weight: 800;
                color: var(--text-main);
                background: var(--surface-warm);
                padding: 0.25rem 0.55rem;
                border-radius: var(--radius-sm);
                border: 1px solid var(--border);
            }
            .step-duree {
                color: var(--text-muted);
                font-weight: 600;
            }
            .step-card h3 {
                font-size: 1.2rem;
                font-weight: 800;
                letter-spacing: -0.02em;
                margin: 0 0 0.6rem;
                color: var(--text-main);
            }
            .step-card p {
                font-size: 0.93rem;
                color: var(--text-muted);
                line-height: 1.6;
                margin: 0 0 1.5rem;
            }
            .step-link {
                font-size: 0.88rem;
                font-weight: 700;
                color: var(--accent);
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                margin-top: auto;
            }
            .step-link::after {
                content: "";
                position: absolute;
                inset: 0;
                border-radius: var(--radius-lg);
            }
            .step-card:hover .step-link {
                text-decoration: underline;
                text-underline-offset: 3px;
            }

            /* 3. COMPARATIF OUTILS (CRO & GEO) */
            .tools-section {
                background: var(--surface-warm);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 2.5rem;
                margin-bottom: 5.5rem;
            }
            .tools-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 1.25rem;
                margin-bottom: 1.5rem;
            }
            .tool-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                padding: 1.4rem;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                text-decoration: none;
                color: inherit;
                transition: border-color 0.15s ease, transform 0.15s ease;
            }
            .tool-card:hover {
                border-color: var(--accent);
                transform: translateY(-2px);
            }
            .tool-header {
                display: flex;
                justify-content: space-between;
                align-items: flex-start;
                gap: 0.5rem;
                margin-bottom: 0.75rem;
            }
            .tool-name {
                font-size: 1.1rem;
                font-weight: 800;
                color: var(--text-main);
                margin: 0;
            }
            .tool-verdict {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.7rem;
                font-weight: 700;
                background: var(--highlight-warm);
                color: var(--amber-text);
                padding: 0.2rem 0.5rem;
                border-radius: var(--radius-sm);
            }
            .tool-usage {
                font-size: 0.9rem;
                color: var(--text-muted);
                margin: 0 0 1.25rem;
                line-height: 1.55;
            }
            .tool-cta {
                font-size: 0.85rem;
                font-weight: 700;
                color: var(--accent);
            }
            .tools-footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
                gap: 1rem;
                padding-top: 1.25rem;
                border-top: 1px dashed var(--border-strong);
                font-size: 0.92rem;
                color: var(--text-muted);
            }
            .link-strong {
                font-weight: 800;
                color: var(--text-main);
                text-decoration: none;
                border-bottom: 2px solid var(--accent);
                padding-bottom: 2px;
            }
            .link-strong:hover { color: var(--accent); }

            /* 4. MANIFESTE ÉDITORIAL (E-E-A-T) */
            .editorial-box {
                background: var(--surface);
                border: 1px solid var(--border-strong);
                border-radius: var(--radius-lg);
                padding: 2.5rem;
                margin-bottom: 5.5rem;
                display: grid;
                grid-template-columns: 1fr 1.2fr;
                gap: 2.5rem;
                align-items: start;
            }
            .editorial-left p {
                color: var(--text-muted);
                font-size: 0.98rem;
                line-height: 1.65;
                margin: 0 0 1.5rem;
            }
            .author-signature {
                display: flex;
                align-items: center;
                gap: 0.9rem;
                padding-top: 1.25rem;
                border-top: 1px solid var(--border);
            }
            .author-monogram {
                width: 44px;
                height: 44px;
                border-radius: var(--radius-md);
                background: var(--text-main);
                color: #fff;
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-weight: 800;
                font-size: 1rem;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }
            .author-name { font-weight: 800; font-size: 0.95rem; margin: 0; color: var(--text-main); }
            .author-role { font-size: 0.8rem; color: var(--text-faint); margin: 0; }
            .editorial-pillars {
                display: flex;
                flex-direction: column;
                gap: 0.85rem;
            }
            .pillar-item {
                padding: 1rem 1.15rem;
                background: var(--bg);
                border: 1px solid var(--border);
                border-radius: var(--radius-md);
                font-size: 0.92rem;
                color: var(--text-muted);
                line-height: 1.55;
            }
            .pillar-item strong {
                color: var(--text-main);
                display: block;
                margin-bottom: 0.2rem;
            }

            /* 5. BLOG */
            .blog-section { margin-bottom: 5.5rem; }
            .blog-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
                gap: 1.5rem;
            }
            .post-card {
                background: var(--surface);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                overflow: hidden;
                text-decoration: none;
                color: inherit;
                display: flex;
                flex-direction: column;
                transition: border-color 0.15s ease, transform 0.15s ease;
            }
            .post-card:hover {
                border-color: var(--text-main);
                transform: translateY(-2px);
            }
            .post-image {
                height: 185px;
                width: 100%;
                object-fit: cover;
                background: var(--surface-warm);
                border-bottom: 1px solid var(--border);
            }
            .post-content {
                padding: 1.4rem;
                flex-grow: 1;
                display: flex;
                flex-direction: column;
            }
            .post-title {
                font-size: 1.05rem;
                font-weight: 800;
                line-height: 1.35;
                margin: 0 0 0.85rem;
                color: var(--text-main);
            }
            .post-card:hover .post-title { color: var(--accent); }
            .post-date {
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 0.75rem;
                color: var(--text-faint);
                margin-top: auto;
            }

            /* 6. FAQ */
            .faq-section { margin-bottom: 5.5rem; }
            .faq-list {
                display: flex;
                flex-direction: column;
                border-top: 1px solid var(--border-strong);
            }
            .faq-item {
                border-bottom: 1px solid var(--border-strong);
                background: transparent;
            }
            .faq-item summary {
                padding: 1.35rem 0.5rem;
                font-size: 1.05rem;
                font-weight: 700;
                color: var(--text-main);
                cursor: pointer;
                list-style: none;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 1rem;
            }
            .faq-item summary::-webkit-details-marker { display: none; }
            .faq-item summary:hover { color: var(--accent); }
            .faq-item summary::after {
                content: "+";
                font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                font-size: 1.35rem;
                color: var(--text-muted);
                transition: transform 0.2s ease;
            }
            .faq-item[open] summary::after { transform: rotate(45deg); color: var(--accent); }
            .faq-answer {
                padding: 0 0.5rem 1.5rem;
                font-size: 0.96rem;
                color: var(--text-muted);
                line-height: 1.65;
                max-width: 780px;
            }

            /* 7. CTA FINAL */
            .final-cta {
                background: var(--surface-dark);
                color: #fff;
                border-radius: var(--radius-lg);
                padding: 3.5rem 2.5rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 2rem;
                flex-wrap: wrap;
            }
            .final-cta-text { max-width: 560px; }
            .final-cta-text h2 {
                color: #fff;
                margin: 0 0 0.65rem;
            }
            .final-cta-text p {
                color: #d6d3cd;
                margin: 0;
                font-size: 1rem;
                line-height: 1.6;
            }
            .btn-light {
                background: #fff;
                color: var(--text-main);
                padding: 1rem 1.75rem;
                border-radius: var(--radius-md);
                font-size: 0.98rem;
                font-weight: 800;
                text-decoration: none;
                box-shadow: 0 3px 0 var(--accent);
                transition: transform 0.15s ease;
                white-space: nowrap;
            }
            .btn-light:hover { transform: translateY(-2px); }

            @media (max-width: 860px) {
                .hero, .editorial-box {
                    grid-template-columns: 1fr;
                    gap: 2rem;
                }
                .tools-section, .editorial-box, .final-cta {
                    padding: 1.75rem 1.25rem;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                * { transition: none !important; }
                html { scroll-behavior: auto; }
            }
        </style>
    </head>
    <body>
        <Header />
        <main>
            <!-- 1. HERO ASYMÉTRIQUE AVEC PREUVE -->
            <section class="hero">
                <div>
                    <h1>
                        Apprendre l'anglais avec l'IA, <mark>sans réciter de listes.</mark>
                    </h1>
                    <p class="hero-lead">
                        Transformez ChatGPT et les coachs vocaux en tuteurs personnels. Des protocoles concrets pour améliorer votre oral et votre compréhension en autonomie.
                    </p>
                    <div class="hero-actions">
                        <a href="/test-niveau-anglais-chatgpt/" class="btn-primary">
                            <span>Évaluer mon niveau (10 min)</span>
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                        <a href="#guide" class="btn-secondary">Parcourir les 6 étapes</a>
                    </div>
                    <div class="hero-meta">
                        <span><span style="color: #111827;">✓ Prompts prêts à copier</span></span>
                        <span><span style="color: #111827;">✓ Compatible ChatGPT gratuit</span></span>
                        <span><span style="color: #111827;">✓ Zéro inscription</span></span>
                    </div>
                </div>

                <aside class="prompt-preview" aria-label="Exemple de prompt concret">
                    <div class="prompt-preview-header">
                        <span>EXTRAIT</span>
                    </div>
                    <div class="prompt-box">
                        « Agis comme un recruteur anglophone à Londres. Pose-moi une seule question à la fois. Après chacune de mes réponses, corrige mes tournures maladroites avant de continuer. »
                    </div>
                    <div class="prompt-feedback">
                        <strong>Résultat :</strong> Vous pratiquez de vraies conversations et corrigées en direct, sans le blocage du regard des autres.
                    </div>
                </aside>
            </section>

            <!-- 2. ROADMAP EN 6 ÉTAPES -->
            <section id="guide" class="roadmap-section">
                <div class="section-header-split">
                    <div>

                        <h2>Le parcours structuré en 6 étapes</h2>
                    </div>
                    <p>Suivez l'ordre chronologique si vous partez de zéro, ou piochez directement la brique qui vous bloque aujourd'hui.</p>
                </div>

                <div class="steps-grid">
                    {
                        etapes.map((etape) => (
                            <article class={`step-card ${etape.featured ? 'is-featured' : ''}`}>
                                <div>
                                    <div class="step-top">
                                        <span class="step-num">{etape.num} &middot; {etape.phase}</span>
                                        <span class="step-duree">⏱ {etape.duree}</span>
                                    </div>
                                    <h3>{etape.title}</h3>
                                    <p>{etape.desc}</p>
                                </div>
                                <a href={etape.link} class="step-link">{etape.cta} &rarr;</a>
                            </article>
                        ))
                    }
                </div>
            </section>

            <!-- 3. COMPARATIF DES OUTILS (CRO & GEO) -->
            <section id="outils" class="tools-section">
                <div class="section-header-split">
                    <div>

                        <h2>Quelle application choisir selon votre profil ?</h2>
                    </div>
                    <p>Au-delà de ChatGPT, j'ai testé plusieurs applications dédiées à l'oral. Voici mes retours.</p>
                </div>

                <div class="tools-grid">
                    {
                        outilsComparatif.map((outil) => (
                            <a href={outil.link} class="tool-card">
                                <div>
                                    <div class="tool-header">
                                        <h3 class="tool-name">{outil.nom}</h3>
                                        <span class="tool-verdict">{outil.verdict}</span>
                                    </div>
                                    <p class="tool-usage">{outil.usage}</p>
                                </div>
                                <span class="tool-cta">{outil.cta} &rarr;</span>
                            </a>
                        ))
                    }
                </div>

                <div class="tools-footer">
                    <span>Vous hésitez entre un tuteur gratuit et une application vocale dédiée ?</span>
                    <a href="/meilleures-ia-anglais/" class="link-strong">
                        Consulter le comparatif complet des IA d'anglais 2026 &rarr;
                    </a>
                </div>
            </section>

            <!-- 4. APPROCHE ÉDITORIALE -->
            <section class="editorial-box">
                <div class="editorial-left">
                    <h2>Un carnet de terrain, pas une énième méthode miracle</h2>
                    <p>
                        J'ai créé Parler Malin avec une idée simple : documenter comment utiliser concrètement l'intelligence artificielle pour améliorer son anglais.
                    </p>
                    <div class="author-signature">
                        <div class="author-monogram" aria-hidden="true">JM</div>
                        <div>
                            <p class="author-name">Jérémy — Parler Malin</p>
                            <p class="author-role">Éditeur indépendant &bull; <a href="/a-propos/" class="link-strong" style="border-width:1px;">En savoir plus sur ma démarche</a></p>
                        </div>
                    </div>
                </div>

                <div class="editorial-pillars">
                    <div class="pillar-item">
                        <strong>1. Prompts testés et prêts à l'emploi</strong>
                        Pas de théorie abstraite : chaque guide contient les instructions exactes à copier-coller dans ChatGPT.
                    </div>
                    <div class="pillar-item">
                        <strong>2. Avis indépendants sur les applications</strong>
                        Je teste chaque outil vocal en conditions réelles pour vous dire honnêtement s'il vaut son abonnement ou si ChatGPT gratuit suffit.
                    </div>
                    <div class="pillar-item">
                        <strong>3. Objectif : parler dans le monde réel</strong>
                        L'IA est un tremplin sécurisant pour gagner en confiance avant de parler avec de vrais interlocuteurs anglophones.
                    </div>
                </div>
            </section>

            <!-- 5. DERNIERS ARTICLES -->
            <section class="blog-section">
                <div class="section-header-split">
                    <div>
                        <h2>Les derniers guides et tests</h2>
                    </div>
                    <a href="/blog/" class="link-strong">Explorer tous les articles &rarr;</a>
                </div>

                <div class="blog-grid">
                    {
                        posts.map((post) => (
                            <a href={`/${post.id}/`} class="post-card">
                                {post.data.heroImage && (
                                    <img
                                        src={typeof post.data.heroImage === 'string' ? post.data.heroImage : (post.data.heroImage as any)?.src}
                                        alt={String((post.data as any).heroImageAlt || post.data.title || '')}
                                        width="640"
                                        height="360"
                                        loading="lazy"
                                        class="post-image"
                                    />
                                )}
                                <div class="post-content">
                                    <h3 class="post-title">{post.data.title}</h3>
                                    <span class="post-date">
                                        {(post.data.pubDate || post.data.date) && (
                                            <FormattedDate date={post.data.pubDate || post.data.date} />
                                        )}
                                    </span>
                                </div>
                            </a>
                        ))
                    }
                </div>
            </section>

            <!-- 6. FAQ -->
            <section class="faq-section">
                <div class="section-header-split">
                    <div>
                        <h2>Questions fréquentes</h2>
                    </div>
                </div>

                <div class="faq-list">
                    {
                        faq.map(({ q, a }) => (
                            <details class="faq-item">
                                <summary>{q}</summary>
                                <div class="faq-answer">{a}</div>
                            </details>
                        ))
                    }
                </div>
            </section>

            <!-- 7. CTA FINAL -->
            <section class="final-cta">
                <div class="final-cta-text">
                    <span class="eyebrow" style="color: #93c5fd;">Étape 01 recommandée</span>
                    <h2>Connaissez-vous votre vrai niveau actuel ?</h2>
                    <p>
                        Ne démarrez pas à l'aveugle. Utilisez notre protocole de prompts pour évaluer votre écrit et votre oral en 10 minutes avec ChatGPT.
                    </p>
                </div>
                <a href="/test-niveau-anglais-chatgpt/" class="btn-light">
                    Lancer le test de niveau gratuit &rarr;
                </a>
            </section>
        </main>
        <Footer />
        <CookieBanner />
    </body>
</html>