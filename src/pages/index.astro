---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const PAGES_EXCLUES = [
	'home',
	'a-propos',
	'conditions-generales-dutilisation',
	'mentions-legales',
	'plan-du-site',
	'politique-de-confidentialite-rgpd',
	'politique-de-cookies-ue',
];

const posts = (await getCollection('blog'))
	.filter((post) => !PAGES_EXCLUES.includes(post.id))
	.sort((a, b) => {
		const dateA = new Date(a.data.pubDate || a.data.date || 0).valueOf();
		const dateB = new Date(b.data.pubDate || b.data.date || 0).valueOf();
		return dateB - dateA;
	})
	.slice(0, 3);

const etapes = [
	{
		num: '01',
		title: 'Estimer son niveau',
		desc: "Les prompts à copier-coller pour transformer ChatGPT en test interactif (QCM, compréhension et oral) afin d'évaluer votre niveau réel.",
		link: '/test-niveau-anglais-chatgpt/',
	},
	{
		num: '02',
		title: 'Créer un plan d’étude',
		desc: "Le prompt exact pour structurer votre apprentissage et générer un planning sur mesure avec l'IA.",
		link: '/routine-anglais-chatgpt/',
	},
	{
		num: '03',
		title: 'Vocabulaire & Grammaire',
		desc: "Générez des exercices de vocabulaire et de grammaire contextualisés selon vos centres d'intérêt.",
		link: '/apprendre-vocabulaire-anglais-chatgpt/',
	},
	{
		num: '04',
		title: 'Corriger sa prononciation',
		desc: "Découvrez les coachs vocaux IA capables d'analyser et corriger votre accent en temps réel.",
		link: '/ia-prononciation-anglais/',
	},
	{
		num: '05',
		title: 'Converser en vocal',
		desc: "Mises en situation et roleplay guidés pour dialoguer à l'oral avec une IA bienveillante.",
		link: '/reussir-conversation-en-anglais-avec-ia/',
	},
	{
		num: '06',
		title: 'Valider dans le monde réel',
		desc: "Surmonter l'anxiété de prise de parole et passer de l'entraînement IA aux échanges natifs.",
		link: '/pratiquer-anglais-natifs/',
	},
];
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 860px;
				margin: auto;
				padding: 2.5rem 1.5rem 5rem;
			}

			/* Hero */
			.hero {
				text-align: center;
				padding: 3.5rem 0 3rem;
			}
			.badge {
				display: inline-flex;
				align-items: center;
				padding: 0.35rem 0.9rem;
				border-radius: 9999px;
				background-color: var(--accent-subtle);
				color: var(--accent);
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 1.5rem;
				border: 1px solid var(--accent-border);
			}
			.hero h1 {
				font-size: clamp(2.2rem, 5vw, 3.2rem);
				line-height: 1.15;
				margin-bottom: 1rem;
				color: var(--text-main);
			}
			.hero p {
				font-size: 1.2rem;
				color: var(--text-muted);
				max-width: 620px;
				margin: 0 auto 2.2rem;
				line-height: 1.6;
			}
			.btn-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				background: var(--accent);
				color: #fff;
				padding: 0.85rem 1.8rem;
				border-radius: 10px;
				font-weight: 600;
				font-size: 1rem;
				text-decoration: none;
				box-shadow: 0 4px 14px 0 rgba(37, 99, 235, 0.35);
				transition: all 0.2s ease;
			}
			.btn-cta:hover {
				background: var(--accent-hover);
				transform: translateY(-1px);
				box-shadow: 0 6px 20px 0 rgba(37, 99, 235, 0.45);
				color: #fff;
			}

			/* Section Guide */
			.section-header {
				text-align: center;
				margin: 4.5rem 0 2.5rem;
			}
			.section-header h2 {
				margin: 0 0 0.5rem;
			}
			.section-header p {
				color: var(--text-muted);
				margin: 0;
			}
			.steps-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.25rem;
			}
			.step-card {
				background: #ffffff;
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				transition: all 0.2s ease;
				box-shadow: var(--shadow-sm);
			}
			.step-card:hover {
				border-color: #cbd5e1;
				transform: translateY(-2px);
				box-shadow: var(--shadow-md);
			}
			.step-num {
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--accent);
				background: var(--accent-subtle);
				padding: 0.2rem 0.6rem;
				border-radius: 6px;
				display: inline-block;
				margin-bottom: 0.75rem;
			}
			.step-card h3 {
				margin: 0 0 0.6rem;
				font-size: 1.2rem;
				color: var(--text-main);
			}
			.step-card p {
				font-size: 0.92rem;
				color: var(--text-muted);
				line-height: 1.55;
				margin: 0 0 1.25rem;
			}
			.step-link {
				font-size: 0.9rem;
				font-weight: 600;
				color: var(--accent);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
			}
			.step-link:hover {
				color: var(--accent-hover);
				gap: 0.5rem;
			}

			/* Citation Auteur */
			.quote-wrapper {
				margin: 4.5rem 0;
				background: var(--bg-alt);
				border: 1px solid var(--border-color);
				border-radius: 16px;
				padding: 2rem 2.2rem;
				position: relative;
			}
			.quote-text {
				font-size: 1.05rem;
				line-height: 1.7;
				color: #334155;
				font-style: italic;
				margin: 0 0 1.2rem;
			}
			.author-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}
			.author-name {
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--text-main);
			}
			.author-title {
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			/* Liste articles récents */
			.recent-posts {
				list-style: none;
				padding: 0;
				margin: 1.5rem 0 0;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}
			.post-card-link {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 1.2rem 1.4rem;
				background: #ffffff;
				border: 1px solid var(--border-color);
				border-radius: 10px;
				text-decoration: none;
				transition: all 0.2s ease;
			}
			.post-card-link:hover {
				border-color: var(--accent);
				background: var(--bg-alt);
				transform: translateX(3px);
			}
			.post-card-title {
				font-weight: 600;
				font-size: 1.02rem;
				color: var(--text-main);
			}
			.post-card-date {
				font-size: 0.85rem;
				color: var(--text-light);
				white-space: nowrap;
				margin-left: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Comment améliorer son anglais avec l'IA&nbsp;?</h1>
				<p>
					Utilisez l'Intelligence Artificielle pour pratiquer au quotidien, briser votre plafond de verre et progresser en toute autonomie.
				</p>
				<a href="#guide" class="btn-cta">
					Découvrir le guide
					<span>&darr;</span>
				</a>
			</section>

			<section id="guide">
				<div class="section-header">
					<h2>Progresser avec l'IA : La méthode</h2>
					<p>Un parcours concret en six étapes pour passer de la théorie à l'oral.</p>
				</div>
				<div class="steps-grid">
					{
						etapes.map((etape) => (
							<div class="step-card">
								<div>
									<span class="step-num">{etape.num}</span>
									<h3>{etape.title}</h3>
									<p>{etape.desc}</p>
								</div>
								<a href={etape.link} class="step-link">Consulter le tutoriel &rarr;</a>
							</div>
						))
					}
				</div>
			</section>

			<section class="quote-wrapper">
				<p class="quote-text">
					« Je ne suis pas professeur d'anglais. Je suis un apprenant qui explore le potentiel de l'IA pour débloquer la pratique orale. Ce site est mon carnet de bord. Je teste les outils, j'éprouve les méthodes, et je vous partage ici la structure exacte qui me permet d'avancer. »
				</p>
				<div class="author-meta">
					<div>
						<div class="author-name">Jean</div>
						<div class="author-title">Co-créateur de Parler Malin</div>
					</div>
				</div>
			</section>

			<section>
				<div class="section-header" style="text-align: left; margin-bottom: 1.2rem;">
					<h2>Derniers Articles</h2>
				</div>
				<ul class="recent-posts">
					{
						posts.map((post) => (
							<li>
								<a href={`/${post.id}/`} class="post-card-link">
									<span class="post-card-title">{post.data.title}</span>
									<span class="post-card-date">
										{(post.data.pubDate || post.data.date) && (
											<FormattedDate date={post.data.pubDate || post.data.date} />
										)}
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>